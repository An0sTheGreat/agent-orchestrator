<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- for NotifyIcon only (desktop notifications, MainWindow.Notify.cs); its namespaces stay out of the global usings -->
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Agent Orchestrator</AssemblyName>
    <!-- Shown at the bottom of Settings, with the git commit the SDK appends (+sha) -->
    <Version>1.1.0</Version>
    <RootNamespace>AgentOrchestrator</RootNamespace>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!-- dist is the single EXE: no package XML docs beside it -->
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
    <AllowedReferenceRelatedFileExtensions>.pdb</AllowedReferenceRelatedFileExtensions>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\title.png" />    <!-- Inter, Newsreader and JetBrains Mono (SIL Open Font License; the licenses are beside them in Fonts\) -->
    <Resource Include="Fonts\*.ttf" />
    <!-- model makers' logos on the Remote API page (LobeHub icons, MIT; the notice is beside them) -->
    <Resource Include="Assets\Vendors\*.png" />
    <None Remove="Assets\make_icon.py" />
    <!-- the tailnet phone app (WebServer.cs), named by its path under web\ with forward slashes: web/index.html, web/assets/fonts/... -->
    <EmbeddedResource Include="web\**" Exclude="web\test\**" LogicalName="web/$([System.String]::Copy('%(RecursiveDir)').Replace('\', '/'))%(Filename)%(Extension)" />
    <!-- the terminal panel's xterm.js (MIT; the licenses are beside it in Terminal\) -->
    <EmbeddedResource Include="Terminal\xterm.js" LogicalName="xterm.js" />
    <EmbeddedResource Include="Terminal\xterm.css" LogicalName="xterm.css" />
    <EmbeddedResource Include="Terminal\addon-fit.js" LogicalName="addon-fit.js" />
  </ItemGroup>
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2849.39" />
    <!-- the phone app address as a QR code (PngByteQRCode: no System.Drawing) -->
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <!-- the editor panel's text surface (MainWindow.Editor.cs), MIT -->
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
    <PackageReference Include="Vortice.Direct2D1" Version="3.8.3" />
    <!-- speech to text and voice activity on the CPU (Speech.cs), Apache-2.0; its win-x64 natives come from org.k2fsa.sherpa.onnx.runtime.win-x64 -->
    <PackageReference Include="org.k2fsa.sherpa.onnx" Version="2.0.3" />
    <!-- microphone capture and device names (Settings > Voice), MIT; 2.2.1 is the last release with a net8 target (3.x is net9+) -->
    <PackageReference Include="NAudio" Version="2.2.1" />
    <!-- Chatterbox Turbo (Chatterbox.cs), MIT: the managed API only; its DirectML onnxruntime.dll is installed into chatterbox\runtime\ -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime.Managed" Version="1.24.4" />
  </ItemGroup>
</Project>
