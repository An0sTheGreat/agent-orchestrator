<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- for NotifyIcon only (desktop notifications, MainWindow.Notify.cs); its namespaces stay out of the global usings -->
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Agent Orchestrator</AssemblyName>
    <!-- Shown at the bottom of Settings, with the git commit the SDK appends (+sha) -->
    <Version>1.1.0</Version>
    <RootNamespace>AgentOrchestrator</RootNamespace>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!-- dist is the single EXE: no package XML docs beside it -->
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
    <AllowedReferenceRelatedFileExtensions>.pdb</AllowedReferenceRelatedFileExtensions>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\title.png" />
    <!-- Inter, Newsreader and JetBrains Mono (SIL Open Font License; the licenses are beside them in Fonts\) -->
    <Resource Include="Fonts\*.ttf" />
    <!-- model makers' logos on the Remote API page (LobeHub icons, MIT; the notice is beside them) -->
    <Resource Include="Assets\Vendors\*.png" />
    <None Remove="Assets\make_icon.py" />
    <EmbeddedResource Include="remote.html" LogicalName="remote.html" />
  </ItemGroup>
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2849.39" />
    <!-- the remote access address as a QR code (PngByteQRCode: no System.Drawing) -->
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <PackageReference Include="Vortice.Direct2D1" Version="3.8.3" />
  </ItemGroup>
</Project>
