<Window x:Class="AgentOrchestrator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:AgentOrchestrator"
        Title="Agent Orchestrator" Width="1400" Height="860" MinWidth="1040" MinHeight="620"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize" Icon="/Assets/app.ico"
        Background="{DynamicResource AppBackground}" Foreground="{DynamicResource TextPrimary}" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        TextOptions.TextFormattingMode="Ideal">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" CornerRadius="0"
                            GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <SolidColorBrush x:Key="AppBackground" Color="#101116" />
        <SolidColorBrush x:Key="TextPrimary" Color="#ECEEF5" />
        <SolidColorBrush x:Key="TitleBackground" Color="#101116" />
        <SolidColorBrush x:Key="Panel" Color="#16171D" />
        <SolidColorBrush x:Key="Card" Color="#1E2028" />
        <SolidColorBrush x:Key="Hover" Color="#292C36" />
        <SolidColorBrush x:Key="Border" Color="#242630" />
        <SolidColorBrush x:Key="Muted" Color="#8E93A6" />
        <SolidColorBrush x:Key="Accent" Color="#4C8DFF" />
        <SolidColorBrush x:Key="AccentLight" Color="#86B3FF" />
        <SolidColorBrush x:Key="ControlBorder" Color="#00000000" />
        <SolidColorBrush x:Key="OnAccent" Color="#FFFFFF" />
        <CornerRadius x:Key="ControlRadius">17</CornerRadius>
        <CornerRadius x:Key="CardRadius">14</CornerRadius>
        <CornerRadius x:Key="PanelRadius">14</CornerRadius>
        <CornerRadius x:Key="SmallRadius">10</CornerRadius>
        <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>

        <!-- Material: raised surfaces carry a 1 px EdgeHighlight rim (light at the top edge, fading out), and fade in an
             AccentEdge rim on hover through an overlay named HoverFill. ApplyTheme / ApplyAccent build these brushes,
             and AccentGradient, AccentGlow and ShimmerBrush, so they follow the theme and accent. -->
        <Style x:Key="HoverRim" TargetType="Border">
            <Setter Property="BorderThickness" Value="1" /><Setter Property="BorderBrush" Value="{DynamicResource AccentEdge}" />
            <Setter Property="Opacity" Value="0" /><Setter Property="IsHitTestVisible" Value="False" />
        </Style>

        <!-- State motion shared by the control templates: a per-control overlay named HoverFill fades in and out,
             and a template root named Root carrying a ScaleTransform shrinks slightly while pressed.
             Only Opacity and RenderTransform are animated; the shared theme brushes never are. -->
        <Storyboard x:Key="HoverIn"><DoubleAnimation Storyboard.TargetName="HoverFill" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" /></Storyboard>
        <Storyboard x:Key="HoverOut"><DoubleAnimation Storyboard.TargetName="HoverFill" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" /></Storyboard>
        <Storyboard x:Key="PressIn">
            <DoubleAnimation Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleX" To="0.97" Duration="0:0:0.08" />
            <DoubleAnimation Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleY" To="0.97" Duration="0:0:0.08" />
        </Storyboard>
        <Storyboard x:Key="PressOut">
            <DoubleAnimation Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.12" />
            <DoubleAnimation Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.12" />
        </Storyboard>

        <Style TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="Background" Value="{DynamicResource Card}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform><ScaleTransform x:Name="RootScale" /></Grid.RenderTransform>
                            <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{DynamicResource ControlRadius}">
                                <Grid>
                                    <Border x:Name="HoverFill" Background="{DynamicResource Hover}" CornerRadius="{DynamicResource ControlRadius}" Opacity="0" />
                                    <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource HoverIn}" /></Trigger.EnterActions>
                                <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource HoverOut}" /></Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource PressIn}" /></Trigger.EnterActions>
                                <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource PressOut}" /></Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource AccentGradient}" />
            <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
            <Setter Property="BorderBrush" Value="{DynamicResource EdgeHighlight}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform><ScaleTransform x:Name="RootScale" /></Grid.RenderTransform>
                            <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{DynamicResource ControlRadius}">
                                <Grid>
                                    <!-- Hover lays a light sheen over the accent gradient, brightening it toward the top. -->
                                    <Border x:Name="HoverFill" CornerRadius="{DynamicResource ControlRadius}" Opacity="0">
                                        <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#40FFFFFF" Offset="0" /><GradientStop Color="#14FFFFFF" Offset="1" /></LinearGradientBrush></Border.Background>
                                    </Border>
                                    <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource AccentLight}" />
                                <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource HoverIn}" /></Trigger.EnterActions>
                                <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource HoverOut}" /></Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource PressIn}" /></Trigger.EnterActions>
                                <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource PressOut}" /></Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
        </Style>
        <Style x:Key="TitleButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="46" /><Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" /><Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource TitleButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Root" Background="Transparent" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform><ScaleTransform x:Name="RootScale" /></Grid.RenderTransform>
                            <Border x:Name="HoverFill" Background="#C42B1C" Opacity="0" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="White" />
                                <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource HoverIn}" /></Trigger.EnterActions>
                                <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource HoverOut}" /></Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource PressIn}" /></Trigger.EnterActions>
                                <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource PressOut}" /></Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="11" /><Setter Property="Foreground" Value="{DynamicResource Muted}" />
        </Style>
        <Style x:Key="SubHeader" TargetType="TextBlock" BasedOn="{StaticResource SectionHeader}">
            <Setter Property="Margin" Value="8,24,0,8" />
        </Style>
        <!-- Large figures on the worker cards: tabular digits so streaming numbers do not jitter. -->
        <Style x:Key="CardValue" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" /><Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Typography.NumeralAlignment" Value="Tabular" />
            <Setter Property="Margin" Value="0,1,0,0" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" /><Setter Property="Background" Value="{DynamicResource Card}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}" /><Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,8" /><Setter Property="CaretBrush" Value="{DynamicResource AccentLight}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Field" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource ControlRadius}"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Hidden" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Field" Property="BorderBrush" Value="{DynamicResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Field" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" /><Setter Property="Background" Value="{DynamicResource Card}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}" /><Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,8" /><Setter Property="CaretBrush" Value="{DynamicResource AccentLight}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="Field" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource ControlRadius}"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Hidden" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Field" Property="BorderBrush" Value="{DynamicResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Field" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <BulletDecorator Background="Transparent">
                            <BulletDecorator.Bullet>
                                <Grid Width="14" Height="14" Margin="0,0,7,0">
                                    <Ellipse x:Name="Ring" Fill="{DynamicResource Card}" Stroke="{DynamicResource Muted}" StrokeThickness="1.5" />
                                    <Ellipse x:Name="Dot" Width="7" Height="7" Fill="{DynamicResource AccentLight}" Visibility="Collapsed" />
                                </Grid>
                            </BulletDecorator.Bullet>
                            <ContentPresenter VerticalAlignment="Center" Margin="4,0,0,0" />
                        </BulletDecorator>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource AccentLight}" />
                                <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="White" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Icon in the collapsed sidebar rail; takes its colour from the button that hosts it. -->
        <Style x:Key="RailGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="ToggleSwitch" TargetType="ToggleButton">
            <Setter Property="Width" Value="42" /><Setter Property="Height" Value="23" /><Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <Border Background="{DynamicResource Card}" BorderBrush="{DynamicResource Border}"
                                    BorderThickness="1" CornerRadius="12" />
                            <Border x:Name="TrackOn" Background="{DynamicResource Accent}" BorderBrush="{DynamicResource AccentLight}"
                                    BorderThickness="1" CornerRadius="12" Opacity="0" />
                            <!-- The knob slides the 19 px between its off (left 3) and on (right 3) positions in the 42 px track. -->
                            <Grid x:Name="Knob" Width="17" Height="17" HorizontalAlignment="Left" Margin="3,0,0,0">
                                <Grid.RenderTransform><TranslateTransform x:Name="KnobShift" /></Grid.RenderTransform>
                                <Ellipse Fill="{DynamicResource Muted}" />
                                <Ellipse x:Name="KnobOn" Fill="White" Opacity="0" />
                            </Grid>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="KnobShift" Storyboard.TargetProperty="X" To="19" Duration="0:0:0.16">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="TrackOn" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.16" />
                                            <DoubleAnimation Storyboard.TargetName="KnobOn" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.16" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="KnobShift" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.16">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="TrackOn" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16" />
                                            <DoubleAnimation Storyboard.TargetName="KnobOn" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ContextMenu">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="HasDropShadow" Value="False" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{DynamicResource Card}" BorderBrush="{DynamicResource Border}" BorderThickness="1"
                                CornerRadius="{DynamicResource SmallRadius}" Padding="5">
                            <ScrollViewer MaxHeight="460" VerticalScrollBarVisibility="Auto">
                                <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MenuSeparator" TargetType="Separator">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1" Margin="8,4" Background="{DynamicResource Border}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="Padding" Value="8,7" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Row" Background="Transparent" CornerRadius="{DynamicResource SmallRadius}" Padding="{TemplateBinding Padding}" Margin="0,1">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" MinWidth="120" /></Grid.ColumnDefinitions>
                                <TextBlock x:Name="Check" Text="&#x2713;" Foreground="{DynamicResource AccentLight}" FontWeight="Bold"
                                           VerticalAlignment="Center" Visibility="Collapsed" />
                                <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="False" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="Check" Property="Visibility" Value="Visible" /></Trigger>
                            <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource Hover}" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Row" Property="Opacity" Value="0.45" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NavToggle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="Padding" Value="14,8,10,8" />
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Background="Transparent">
                            <Border x:Name="HoverFill" Background="{DynamicResource Hover}" CornerRadius="{DynamicResource ControlRadius}" Opacity="0" />
                            <Border x:Name="CheckedFill" Background="{DynamicResource Card}" CornerRadius="{DynamicResource ControlRadius}" Opacity="0" />
                            <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                            <Border x:Name="Bar" Width="3" Height="16" CornerRadius="2" Background="{DynamicResource Accent}"
                                    HorizontalAlignment="Left" Margin="4,0,0,0" Opacity="0" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource HoverIn}" /></Trigger.EnterActions>
                                <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource HoverOut}" /></Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource AccentLight}" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="CheckedFill" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15" />
                                            <DoubleAnimation Storyboard.TargetName="Bar" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="CheckedFill" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" />
                                            <DoubleAnimation Storyboard.TargetName="Bar" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Sidebar list rows that act rather than select (New chat, project headers, "…"): NavToggle's hover, no checked state. -->
        <Style x:Key="SidebarRow" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="Padding" Value="14,6,10,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Border x:Name="HoverFill" Background="{DynamicResource Hover}" CornerRadius="{DynamicResource ControlRadius}" Opacity="0" />
                            <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource HoverIn}" /></Trigger.EnterActions>
                                <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource HoverOut}" /></Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Chat: segmented Single / Multi toggle, the borderless message box and the rounded composer around it. -->
        <Style x:Key="SegToggle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="Padding" Value="15,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Seg" Background="Transparent" CornerRadius="{DynamicResource ControlRadius}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource TextPrimary}" /></Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Seg" Property="Background" Value="{DynamicResource AccentGradient}" />
                                <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- The composer's Search / Tools / Skills chips: muted text, accent text when on. -->
        <Style x:Key="ChipToggle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Chip" Background="Transparent" CornerRadius="{DynamicResource ControlRadius}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="{DynamicResource Hover}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="{DynamicResource Hover}" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentLight}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ChatInput" TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="CaretBrush" Value="{DynamicResource AccentLight}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="4,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Field" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Field" Property="Opacity" Value="0.5" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ChatBox" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Card}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource PanelRadius}" />
            <Setter Property="Padding" Value="10,8,10,8" />
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource Accent}" /></Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="10" /><Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" /></Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="{DynamicResource Muted}" CornerRadius="3" Margin="2,0" Opacity="0.6" /></ControlTemplate></Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" /></Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Collapsible thinking / tool sections -->
        <Style x:Key="BlockHeaderToggle" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Background="Transparent">
                            <Border x:Name="HoverFill" Background="{DynamicResource Hover}" CornerRadius="{DynamicResource SmallRadius}" Opacity="0" />
                            <DockPanel Margin="12,8">
                                <Grid DockPanel.Dock="Left" Width="16">
                                    <TextBlock x:Name="Glyph" Text="&#x25B8;" Foreground="{DynamicResource Muted}" HorizontalAlignment="Left" VerticalAlignment="Center"
                                               RenderTransformOrigin="0.5,0.5">
                                        <TextBlock.RenderTransform><RotateTransform x:Name="GlyphTurn" /></TextBlock.RenderTransform>
                                    </TextBlock>
                                </Grid>
                                <ContentPresenter VerticalAlignment="Center" />
                            </DockPanel>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource HoverIn}" /></Trigger.EnterActions>
                                <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource HoverOut}" /></Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="GlyphTurn" Storyboard.TargetProperty="Angle" To="90" Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="GlyphTurn" Storyboard.TargetProperty="Angle" To="0" Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="BlockExpander" TargetType="Expander">
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <Grid>
                        <Border Background="{DynamicResource Card}" CornerRadius="{DynamicResource SmallRadius}"
                                BorderBrush="{DynamicResource EdgeHighlight}" BorderThickness="1">
                            <DockPanel>
                                <Grid DockPanel.Dock="Top">
                                    <ToggleButton Style="{StaticResource BlockHeaderToggle}"
                                                  IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                        <ContentPresenter ContentSource="Header" />
                                    </ToggleButton>
                                    <!-- Copy this section; shown while the section is hovered (only then can it be reached). -->
                                    <Button x:Name="SectionCopy" Focusable="False" Content="Copy" FontSize="11" Padding="10,3" Margin="0,0,8,0" Opacity="0"
                                            HorizontalAlignment="Right" VerticalAlignment="Center" ToolTip="Copy this section" Click="SectionCopy_Click" />
                                </Grid>
                                <ContentPresenter x:Name="Body" Margin="14,0,14,12" Visibility="Collapsed">
                                    <ContentPresenter.RenderTransform><TranslateTransform x:Name="BodyShift" /></ContentPresenter.RenderTransform>
                                </ContentPresenter>
                            </DockPanel>
                        </Border>
                        <Border x:Name="HoverFill" Style="{StaticResource HoverRim}" CornerRadius="{DynamicResource SmallRadius}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard Storyboard="{StaticResource HoverIn}" />
                                    <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="SectionCopy" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" /></Storyboard></BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard Storyboard="{StaticResource HoverOut}" />
                                    <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="SectionCopy" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" /></Storyboard></BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <!-- Opening fades and slides the body in; closing stays instant. -->
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="Body" Property="Visibility" Value="Visible" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Body" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.18" />
                                            <DoubleAnimation Storyboard.TargetName="BodyShift" Storyboard.TargetProperty="Y" From="-6" To="0" Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <BooleanToVisibilityConverter x:Key="BoolVis" />
        <Style x:Key="Chip" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Hover}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="9,3" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>

        <ItemsPanelTemplate x:Key="StandardPanel">
            <local:CardGridPanel MinItemWidth="300" MaxItemWidth="300" MaxColumns="2" Spacing="10" />
        </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="CompactPanel">
            <local:CardGridPanel MinItemWidth="190" MaxItemWidth="190" MaxColumns="3" Spacing="10" />
        </ItemsPanelTemplate>

        <!-- Small square card: title plus a pulsing status dot -->
        <DataTemplate x:Key="CompactCardTemplate">
            <Grid x:Name="CardRoot" Tag="CardRoot" Cursor="SizeAll" ToolTip="Drag to reorder; right-click for model, settings and more"
                  PreviewMouseLeftButtonDown="Handle_Down" MouseRightButtonUp="CompactCard_RightClick" Background="Transparent">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Style.Triggers><DataTrigger Binding="{Binding IsDragging}" Value="True"><Setter Property="Opacity" Value="0.3" /></DataTrigger></Style.Triggers>
                    </Style>
                </Grid.Style>
            <Border Background="{DynamicResource Card}" CornerRadius="{DynamicResource PanelRadius}" Padding="14"
                    BorderBrush="{DynamicResource EdgeHighlight}" BorderThickness="1">
                <Grid>
                    <Grid HorizontalAlignment="Right" VerticalAlignment="Top" Width="26" Height="26" Margin="0,-4,-4,0">
                        <Ellipse Width="12" Height="12" Fill="{DynamicResource Accent}" Opacity="0" RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform><ScaleTransform x:Name="RingScale" /></Ellipse.RenderTransform>
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard x:Name="RingPulse">
                                                    <Storyboard RepeatBehavior="Forever">
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.55" To="0" Duration="0:0:1.3" />
                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="1" To="2.1" Duration="0:0:1.3" />
                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="1" To="2.1" Duration="0:0:1.3" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions><StopStoryboard BeginStoryboardName="RingPulse" /></DataTrigger.ExitActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <Ellipse Width="12" Height="12" RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform><ScaleTransform x:Name="CoreScale" /></Ellipse.RenderTransform>
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="#4A4D57" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                            <Setter Property="Fill" Value="{DynamicResource Accent}" />
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard x:Name="CorePulse">
                                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="0.8" To="1.2" Duration="0:0:0.65" />
                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="0.8" To="1.2" Duration="0:0:0.65" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions><StopStoryboard BeginStoryboardName="CorePulse" /></DataTrigger.ExitActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                    </Grid>
                    <StackPanel>
                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontSize="11" Margin="0,0,24,0"
                                   Style="{StaticResource SectionHeader}" Foreground="{DynamicResource AccentLight}" />
                        <TextBlock Text="{Binding ModelName}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding ModelName}" Margin="0,8,0,0" />
                        <TextBlock Text="&#x26A0; Setup incomplete" FontSize="10.5" Foreground="{DynamicResource Muted}" Margin="0,4,0,0" ToolTip="{Binding SetupTip}" Visibility="{Binding HasSetupProblem, Converter={StaticResource BoolVis}}" />
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                            <Border Style="{StaticResource Chip}" Padding="6,1" CornerRadius="6"><TextBlock Text="{Binding Weights}" FontSize="10" /></Border>
                            <Border Style="{StaticResource Chip}" Padding="6,1" CornerRadius="6"><TextBlock Text="{Binding Quant}" FontSize="10" /></Border>
                        </StackPanel>
                        <TextBlock Text="{Binding TokensPerSec}" Style="{StaticResource CardValue}" FontSize="15" Margin="0,8,0,0" />
                        <TextBlock FontSize="11" Foreground="{DynamicResource Muted}" Typography.NumeralAlignment="Tabular" Margin="0,1,0,0"
                                   TextTrimming="CharacterEllipsis" ToolTip="Last completed task's tokens · this turn's tokens">
                            <Run Text="{Binding TaskTokens, Mode=OneWay}" /><Run Text=" task  ·  " /><Run Text="{Binding TurnTotal, Mode=OneWay}" /><Run Text=" tokens" />
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Border>
            <Border x:Name="HoverFill" Style="{StaticResource HoverRim}" CornerRadius="{DynamicResource PanelRadius}" />
            </Grid>
            <DataTemplate.Triggers>
                <Trigger SourceName="CardRoot" Property="IsMouseOver" Value="True">
                    <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource HoverIn}" /></Trigger.EnterActions>
                    <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource HoverOut}" /></Trigger.ExitActions>
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="RoleCardTemplate">
            <Grid x:Name="CardRoot" Tag="CardRoot">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Style.Triggers><DataTrigger Binding="{Binding IsDragging}" Value="True"><Setter Property="Opacity" Value="0.3" /></DataTrigger></Style.Triggers>
                    </Style>
                </Grid.Style>
            <Border Background="{DynamicResource Card}" CornerRadius="{DynamicResource PanelRadius}" Padding="16,14" BorderThickness="1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="{DynamicResource EdgeHighlight}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DropHover}" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource Accent}" /></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Text="&#x2630;" Foreground="{DynamicResource Muted}" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"
                                   Cursor="SizeAll" ToolTip="Drag to reorder" Background="Transparent" PreviewMouseLeftButtonDown="Handle_Down" />
                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="&#x2715;" Padding="7,2" Margin="4,0,0,0" FontSize="11"
                                ToolTip="Remove this worker" Visibility="{Binding IsCustom, Converter={StaticResource BoolVis}}" Click="RemoveWorker_Click" />
                        <Border DockPanel.Dock="Right" CornerRadius="9" Padding="9,2" VerticalAlignment="Center">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource Hover}" />
                                    <Style.Triggers><DataTrigger Binding="{Binding IsActive}" Value="True"><Setter Property="Background" Value="{DynamicResource Accent}" /></DataTrigger></Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding Status}" FontSize="10" FontFamily="Consolas" FontWeight="Bold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource Muted}" />
                                        <Style.Triggers><DataTrigger Binding="{Binding IsActive}" Value="True"><Setter Property="Foreground" Value="{DynamicResource OnAccent}" /></DataTrigger></Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                        <Grid VerticalAlignment="Center">
                            <TextBlock Text="{Binding Title}" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource SectionHeader}">
                                        <Setter Property="Foreground" Value="{DynamicResource AccentLight}" />
                                        <Style.Triggers><DataTrigger Binding="{Binding IsCustom}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" FontWeight="SemiBold" FontSize="11" Padding="8,3"
                                     Background="{DynamicResource Hover}" ToolTip="Worker title (editable)" LostFocus="TitleBox_LostFocus" MaxLength="32">
                                <TextBox.Style>
                                    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers><DataTrigger Binding="{Binding IsCustom}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                        </Grid>
                    </DockPanel>

                    <TextBlock Text="MODEL" Style="{StaticResource SectionHeader}" FontSize="10" Margin="0,14,0,0" />
                    <DockPanel Margin="0,2,0,0">
                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Settings" Padding="9,3" FontSize="11" Margin="8,0,0,0"
                                IsEnabled="{Binding Editable}" ToolTip="Edit temperature, max tokens, context length and more (custom workers: kind, description and system prompt too)"
                                Click="RoleSettings_Click" />
                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Change" Padding="9,3" FontSize="11" Margin="8,0,0,0"
                                IsEnabled="{Binding Editable}" ToolTip="Pick from the models installed in Unsloth" Click="ChangeModel_Click" />
                        <TextBlock Text="{Binding ModelName}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding ModelName}" VerticalAlignment="Center" />
                    </DockPanel>

                    <TextBlock Text="&#x26A0; Setup incomplete" FontSize="10.5" Foreground="{DynamicResource Muted}" Margin="0,4,0,0" ToolTip="{Binding SetupTip}" Visibility="{Binding HasSetupProblem, Converter={StaticResource BoolVis}}" />
                    <TextBlock Text="WEIGHTS / QUANTIZATION" Style="{StaticResource SectionHeader}" FontSize="10" Margin="0,14,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Border Style="{StaticResource Chip}"><TextBlock Text="{Binding Weights}" FontSize="12" /></Border>
                        <Border Style="{StaticResource Chip}"><TextBlock Text="{Binding Quant}" FontSize="12" /></Border>
                    </StackPanel>

                    <TextBlock Text="TOKENS / SEC" Style="{StaticResource SectionHeader}" FontSize="10" Margin="0,14,0,0" />
                    <TextBlock Text="{Binding TokensPerSec}" Style="{StaticResource CardValue}" />
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <StackPanel ToolTip="Tokens this worker used in the last completed task (prompt + generated)">
                            <TextBlock Text="TASK TOKENS" Style="{StaticResource SectionHeader}" FontSize="10" />
                            <TextBlock Text="{Binding TaskTokens}" Style="{StaticResource CardValue}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="TURN TOKENS" Style="{StaticResource SectionHeader}" FontSize="10" />
                            <TextBlock Text="{Binding TurnTotal}" Style="{StaticResource CardValue}" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{Binding TurnDetail}" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,2,0,0" />
                </StackPanel>
            </Border>
            <Border x:Name="HoverFill" Style="{StaticResource HoverRim}" CornerRadius="{DynamicResource PanelRadius}" />
            </Grid>
            <DataTemplate.Triggers>
                <Trigger SourceName="CardRoot" Property="IsMouseOver" Value="True">
                    <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource HoverIn}" /></Trigger.EnterActions>
                    <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource HoverOut}" /></Trigger.ExitActions>
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="34" /><RowDefinition Height="62" /><RowDefinition Height="*" /><RowDefinition Height="34" />
        </Grid.RowDefinitions>

        <Grid x:Name="ThemeBackdrop" Grid.RowSpan="4" Visibility="Collapsed" IsHitTestVisible="False" Background="{DynamicResource AppBackground}">
            <Ellipse Width="820" Height="820" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-260,-330,0,0">
                <Ellipse.Fill><RadialGradientBrush><GradientStop x:Name="GlassA1" Color="#70558CFF" Offset="0" /><GradientStop x:Name="GlassA2" Color="#00465A9C" Offset="1" /></RadialGradientBrush></Ellipse.Fill>
            </Ellipse>
            <Ellipse Width="900" Height="900" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-350,-410">
                <Ellipse.Fill><RadialGradientBrush><GradientStop x:Name="GlassB1" Color="#5064D8C4" Offset="0" /><GradientStop x:Name="GlassB2" Color="#003C6A73" Offset="1" /></RadialGradientBrush></Ellipse.Fill>
            </Ellipse>
        </Grid>

        <!-- Title bar -->
        <Border x:Name="TitleBar" Grid.Row="0" Background="{DynamicResource TitleBackground}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" MouseMove="TitleBar_MouseMove" MouseLeftButtonUp="TitleBar_MouseLeftButtonUp">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0">
                    <Image Source="/Assets/title.png" Width="18" Height="18" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="AGENT ORCHESTRATOR" Foreground="{DynamicResource AccentLight}" FontFamily="Consolas"
                               FontWeight="Bold" FontSize="12" Margin="7,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource TitleButton}" Content="─" Click="Minimize_Click" />
                    <Button x:Name="MaximizeButton" Style="{StaticResource TitleButton}" Content="□" Click="Maximize_Click" />
                    <Button Style="{StaticResource CloseButton}" Content="×" Click="Close_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Header: project control -->
        <Border Grid.Row="1" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
            <Grid>
            <!-- While a run is in progress a light sweeps along the header's lower edge (SetRunning starts and stops it).
                 The Viewbox stretches a fixed 100-unit track to the header width, so the sweep needs no resize handling. -->
            <Viewbox x:Name="Shimmer" Stretch="Fill" Height="2" VerticalAlignment="Bottom" Margin="0,0,0,-1" Opacity="0" IsHitTestVisible="False">
                <Canvas Width="100" Height="2" ClipToBounds="True">
                    <Rectangle Width="34" Height="2" Fill="{DynamicResource ShimmerBrush}">
                        <Rectangle.RenderTransform><TranslateTransform x:Name="ShimmerShift" X="-34" /></Rectangle.RenderTransform>
                    </Rectangle>
                </Canvas>
            </Viewbox>
            <Grid Margin="14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <!-- Status pill, hidden while Ready (SetStatus): while running, a ring in the dot's colour swells and fades from behind the dot. -->
                <Border x:Name="StatusPill" Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Center" Padding="11,5,13,5" Visibility="Collapsed"
                        Background="{DynamicResource Card}" BorderBrush="{DynamicResource EdgeHighlight}" BorderThickness="1"
                        CornerRadius="{DynamicResource ControlRadius}">
                    <StackPanel Orientation="Horizontal">
                        <Grid Width="9" Height="9" Margin="0,0,8,0" VerticalAlignment="Center">
                            <Ellipse x:Name="StatusRing" Fill="{Binding Fill, ElementName=StatusDot}" Opacity="0" RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform><ScaleTransform x:Name="StatusRingScale" /></Ellipse.RenderTransform>
                            </Ellipse>
                            <Ellipse x:Name="StatusDot" Fill="#667085" />
                        </Grid>
                        <TextBlock x:Name="StatusText" Text="Ready" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <Button x:Name="AccentButton" Grid.Column="3" Padding="11,8" VerticalAlignment="Center" ToolTip="Accent colour for this theme" Click="Accent_Click">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="10" Height="10" Fill="{DynamicResource Accent}" Margin="0,0,7,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="AccentLabel" Text="Accent" />
                    </StackPanel>
                    <Button.ContextMenu><ContextMenu x:Name="AccentMenu" Opened="AccentMenu_Opened" /></Button.ContextMenu>
                </Button>
            </Grid>
            </Grid>
        </Border>

        <!-- Main area: sidebar, the Code / Chat / Options view, worker cards -->
        <Grid x:Name="MainView" Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="380" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition x:Name="DetailsColumn" Width="340" MinWidth="260" MaxWidth="1400" />
            </Grid.ColumnDefinitions>

            <!-- Left-side navigation + project setup. Its width is animated; it collapses to an icon rail. -->
            <Border x:Name="SidePane" Grid.Column="0" Width="260" ClipToBounds="True" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid x:Name="SidebarFull" Width="259" HorizontalAlignment="Left">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="12,20,12,20">
                                <TextBlock Text="VIEW" Style="{StaticResource SectionHeader}" Margin="8,0,0,8" />
                                <ToggleButton x:Name="NavChat" Style="{StaticResource NavToggle}" Content="Chat" Click="Nav_Click" Tag="Chat" ToolTip="Chat with the workers (Ctrl+1)" />
                                <ToggleButton x:Name="NavCode" Style="{StaticResource NavToggle}" Content="Code" IsChecked="True" Click="Nav_Click" Tag="Code" ToolTip="Code in a folder with the workers (Ctrl+2)" />
                                <ToggleButton x:Name="NavOptions" Style="{StaticResource NavToggle}" Content="Options" Click="Nav_Click" Tag="Options" ToolTip="Options (Ctrl+3)" />

                                <!-- The saved Code conversations, built by RefreshSidebarList (MainWindow.Sidebar.cs). -->
                                <StackPanel x:Name="SidebarList" Margin="0,16,0,0" />
                            </StackPanel>
                        </ScrollViewer>
                        <Button x:Name="SidebarCollapseButton" Style="{StaticResource GhostButton}" Width="28" Height="28" Padding="0" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,14,10,0"
                                Click="SidebarToggle_Click" ToolTip="Collapse sidebar (Ctrl+B)" AutomationProperties.Name="Collapse sidebar (Ctrl+B)">
                            <TextBlock Text="&#xE76B;" Style="{StaticResource RailGlyph}" FontSize="12" />
                        </Button>
                    </Grid>
                    <StackPanel x:Name="SidebarRail" Width="53" HorizontalAlignment="Left" Margin="0,14,0,0" Visibility="Collapsed">
                        <Button x:Name="SidebarExpandButton" Style="{StaticResource GhostButton}" Height="28" Margin="12,0,12,14" Padding="0" Click="SidebarToggle_Click" ToolTip="Expand sidebar (Ctrl+B)" AutomationProperties.Name="Expand sidebar (Ctrl+B)">
                            <TextBlock Text="&#xE76C;" Style="{StaticResource RailGlyph}" FontSize="12" />
                        </Button>
                        <Button Style="{StaticResource GhostButton}" Height="28" Margin="12,0,12,14" Padding="0" Click="CodeNew_Click" ToolTip="New chat" AutomationProperties.Name="New chat">
                            <TextBlock Text="&#xE710;" Style="{StaticResource RailGlyph}" FontSize="12" />
                        </Button>
                        <ToggleButton Style="{StaticResource NavToggle}" Height="38" Padding="0" Margin="6,0,6,4" Tag="Chat" Click="Nav_Click" ToolTip="Chat (Ctrl+1)" AutomationProperties.Name="Chat (Ctrl+1)"
                                      IsChecked="{Binding IsChecked, ElementName=NavChat, Mode=TwoWay}">
                            <TextBlock Text="&#xE8F2;" Style="{StaticResource RailGlyph}" />
                        </ToggleButton>
                        <ToggleButton Style="{StaticResource NavToggle}" Height="38" Padding="0" Margin="6,0,6,4" Tag="Code" Click="Nav_Click" ToolTip="Code (Ctrl+2)" AutomationProperties.Name="Code (Ctrl+2)"
                                      IsChecked="{Binding IsChecked, ElementName=NavCode, Mode=TwoWay}">
                            <TextBlock Text="&#xE943;" Style="{StaticResource RailGlyph}" />
                        </ToggleButton>
                        <ToggleButton Style="{StaticResource NavToggle}" Height="38" Padding="0" Margin="6,0,6,4" Tag="Options" Click="Nav_Click" ToolTip="Options (Ctrl+3)" AutomationProperties.Name="Options (Ctrl+3)"
                                      IsChecked="{Binding IsChecked, ElementName=NavOptions, Mode=TwoWay}">
                            <TextBlock Text="&#xE713;" Style="{StaticResource RailGlyph}" />
                        </ToggleButton>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Code: a conversation with a worker about a folder (MainWindow.Code.cs), or the project run's output (ShowCodeRun) -->
            <Grid x:Name="CodeView" Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /><RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DockPanel Margin="20,16,20,0" LastChildFill="False">
                    <TextBlock Text="CODE" Style="{StaticResource SectionHeader}" VerticalAlignment="Center" />
                    <TextBlock x:Name="CodeFolderText" Text="No folder" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"
                               Margin="12,0,0,0" MaxWidth="200" TextTrimming="CharacterEllipsis" />
                    <Button x:Name="CodeProjectButton" Style="{StaticResource GhostButton}" Content="Project  &#x25BE;" FontSize="11" Padding="9,3" Margin="10,0,0,0"
                            VerticalAlignment="Center" Click="CodeProject_Click" IsEnabled="False" ToolTip="PROJECT.md, task limits, extra folders and run options for this folder" />
                    <!-- Project > Folders… shows this panel in a dialog (MainWindow.Code.cs RefreshCodeFolders builds the list) -->
                    <ContentControl x:Name="CodeFoldersHost" Visibility="Collapsed">
                        <StackPanel x:Name="CodeFoldersPanel" Width="340">
                            <TextBlock Text="Folders beyond the project folder the Code worker may read or edit." TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,0,0,8" />
                            <TextBlock x:Name="CodeFoldersEmpty" Text="Choose a project folder first" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="11" Margin="8,0,0,4" />
                            <StackPanel x:Name="CodeFoldersList" />
                            <Button x:Name="AddCodeFolderButton" Content="Add folder…" Margin="0,8,0,0" Click="AddCodeFolder_Click" Visibility="Collapsed"
                                    ToolTip="Let the Code worker read or edit another folder" />
                        </StackPanel>
                    </ContentControl>
                    <Button x:Name="CodeStartButton" DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="Start project" Padding="12,4" FontSize="11"
                            Click="CodeStart_Click" ToolTip="Start or resume the project run in this folder (Ctrl+Enter)" ToolTipService.ShowOnDisabled="True" />
                    <Button x:Name="CodeNewButton" DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="New conversation" Padding="10,4" FontSize="11" Margin="0,0,8,0"
                            Click="CodeNew_Click" ToolTip="Start a new conversation" />
                    <Border DockPanel.Dock="Right" Margin="0,0,10,0" Padding="2" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Border}"
                            BorderThickness="1" CornerRadius="{DynamicResource ControlRadius}">
                        <StackPanel Orientation="Horizontal">
                            <ToggleButton x:Name="CodeConversationToggle" Style="{StaticResource SegToggle}" Content="Conversation" IsChecked="True" Click="CodeSubView_Click"
                                          ToolTip="The conversation with the worker" AutomationProperties.Name="Conversation" />
                            <ToggleButton x:Name="CodeRunToggle" Style="{StaticResource SegToggle}" Content="Run output" Tag="run" Click="CodeSubView_Click"
                                          ToolTip="Model output and the execution log of the project run" AutomationProperties.Name="Run output" />
                        </StackPanel>
                    </Border>
                </DockPanel>
                <Grid x:Name="CodeChat" Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" /><RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Margin="0,8,0,0">
                        <ScrollViewer x:Name="CodeScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,2,0" ScrollChanged="ChatScroll_ScrollChanged">
                            <StackPanel x:Name="CodePanel" Margin="20,0,12,12" />
                        </ScrollViewer>
                        <StackPanel x:Name="CodeEmpty" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock x:Name="CodeEmptyTitle" Text="Choose a folder to start" FontFamily="{StaticResource DisplayFont}" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,6" />
                            <TextBlock Text="The worker can read, search and edit the files in it, then start the project." Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" />
                            <Button Content="Choose a folder…" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center" Padding="16,7" Margin="0,14,0,0" Click="CodeNew_Click" />
                        </StackPanel>
                        <Button x:Name="CodeJumpPill" Style="{StaticResource PrimaryButton}" Content="Jump to latest  ↓" FontSize="12" Padding="16,7"
                                HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,12" Visibility="Collapsed" Opacity="0"
                                ToolTip="Scroll to the newest reply and keep following it" Click="ChatJump_Click" />
                    </Grid>
                    <Border Grid.Row="1" Style="{StaticResource ChatBox}" Margin="20,4,20,16">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <Button x:Name="CodePlus" Style="{StaticResource GhostButton}" Content="+" FontSize="20" Width="34" Height="34" Padding="0,0,0,2"
                                        VerticalAlignment="Bottom" Click="ChatPlus_Click" ToolTip="Choose which worker to message" AutomationProperties.Name="Choose worker" />
                                <TextBox x:Name="CodeInput" Grid.Column="1" Style="{StaticResource ChatInput}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="34" MaxHeight="170"
                                         VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Center" Margin="4,0,8,0"
                                         PreviewKeyDown="ChatInput_PreviewKeyDown" TextChanged="ChatInput_TextChanged" AutomationProperties.Name="Message" />
                                <Button x:Name="CodeStop" Grid.Column="2" Style="{StaticResource GhostButton}" Width="34" Height="34" Padding="0" Margin="0,0,6,0"
                                        VerticalAlignment="Bottom" Visibility="Collapsed" Click="StopWork_Click" ToolTip="Stop (Ctrl+Shift+X)" AutomationProperties.Name="Stop">
                                    <Rectangle Width="11" Height="11" RadiusX="2" RadiusY="2" Fill="{DynamicResource TextPrimary}" />
                                </Button>
                                <Button x:Name="CodeSend" Grid.Column="3" Style="{StaticResource PrimaryButton}" Content="Send" Width="76" Height="34" Padding="0"
                                        VerticalAlignment="Bottom" Click="ChatSend_Click" />
                            </Grid>
                            <DockPanel Grid.Row="1" Margin="4,6,2,0">
                                <Button x:Name="CodeTargetChip" DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Background="{DynamicResource Hover}"
                                        Foreground="{DynamicResource TextPrimary}" FontSize="11" Padding="11,3" Click="ChatTarget_Click" ToolTip="Which worker receives your message" />
                                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="-4,0,8,0">
                                    <ToggleButton x:Name="CodeSearchToggle" Style="{StaticResource ChipToggle}" Tag="search" Click="ExtraToggle_Click" AutomationProperties.Name="Search"
                                                  ToolTip="Let the worker search the web (DuckDuckGo) and read the pages it finds">
                                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE774;" Style="{StaticResource RailGlyph}" FontSize="11" Margin="0,0,5,0" /><TextBlock Text="Search" /></StackPanel>
                                    </ToggleButton>
                                    <ToggleButton x:Name="CodeToolsToggle" Style="{StaticResource ChipToggle}" Tag="tools" Click="ExtraToggle_Click" AutomationProperties.Name="Tools"
                                                  ToolTip="Give the worker utilities: calculator, current date and time, and reading a web page by URL">
                                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE943;" Style="{StaticResource RailGlyph}" FontSize="11" Margin="0,0,5,0" /><TextBlock Text="Tools" /></StackPanel>
                                    </ToggleButton>
                                    <ToggleButton x:Name="CodeSkillsButton" Style="{StaticResource ChipToggle}" Click="Skills_Click" AutomationProperties.Name="Skills"
                                                  ToolTip="Skills the worker may load: folders with a SKILL.md in the skills folder">
                                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8F1;" Style="{StaticResource RailGlyph}" FontSize="11" Margin="0,0,5,0" /><TextBlock Text="Skills  ▾" /></StackPanel>
                                    </ToggleButton>
                                </StackPanel>
                                <TextBlock x:Name="CodeHint" Text="Enter to send  ·  Shift+Enter for a new line" Foreground="{DynamicResource Muted}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                        </Grid>
                    </Border>
                </Grid>

            <!-- Run output: model output + execution log -->
            <Grid x:Name="WorkArea" Grid.Row="1" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DockPanel Margin="20,16,20,8" LastChildFill="False">
                    <TextBlock Text="MODEL OUTPUT" Style="{StaticResource SectionHeader}" VerticalAlignment="Center" />
                    <!-- Run clocks (MainWindow.ShowClocks): the current/last task and the current/last worker turn. -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0" TextBlock.FontSize="11">
                        <TextBlock Text="TASK TIME" Style="{StaticResource SectionHeader}" FontSize="10" VerticalAlignment="Center" />
                        <TextBlock x:Name="TaskTimeText" Text="—" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" MinWidth="34"
                                   Foreground="{DynamicResource TextPrimary}" Margin="6,0,14,0" VerticalAlignment="Center" />
                        <TextBlock Text="TURN TIME" Style="{StaticResource SectionHeader}" FontSize="10" VerticalAlignment="Center" />
                        <TextBlock x:Name="TurnTimeText" Text="—" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" MinWidth="34"
                                   Foreground="{DynamicResource TextPrimary}" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Copy output" Padding="10,4" FontSize="11" Click="CopyOutput_Click" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Clear" Padding="10,4" FontSize="11" Click="ClearOutput_Click" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Collapse all" Padding="10,4" FontSize="11" Click="CollapseAll_Click"
                            ToolTip="Collapse every output section (Ctrl+Shift+E)" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Expand all" Padding="10,4" FontSize="11" Click="ExpandAll_Click"
                            ToolTip="Expand every output section (Ctrl+E)" />
                </DockPanel>
                <Grid Grid.Row="1">
                    <ScrollViewer x:Name="OutputScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,2,0" ScrollChanged="OutputScroll_ScrollChanged">
                        <StackPanel x:Name="OutputPanel" Margin="20,0,12,12" />
                    </ScrollViewer>
                    <!-- Emblem: an accent halo that breathes slowly (EmptyState_IsVisibleChanged) behind a lit disc. -->
                    <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                                IsVisibleChanged="EmptyState_IsVisibleChanged">
                        <Grid Width="160" Height="160" HorizontalAlignment="Center">
                            <Ellipse x:Name="EmblemGlow" Fill="{DynamicResource AccentGlow}" Opacity="0.6" RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform><ScaleTransform x:Name="EmblemScale" /></Ellipse.RenderTransform>
                            </Ellipse>
                            <Ellipse Width="116" Height="116" Stroke="{DynamicResource Border}" StrokeThickness="1" />
                            <Ellipse Width="84" Height="84" Fill="{DynamicResource Card}" Stroke="{DynamicResource AccentEdge}" StrokeThickness="1.5" />
                            <TextBlock Text="◈" FontSize="38" Foreground="{DynamicResource AccentLight}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,3" />
                        </Grid>
                        <TextBlock Text="No output yet" FontFamily="{StaticResource DisplayFont}" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,6,0,6" />
                        <TextBlock Text="Thinking, tool calls and responses appear here as the agents work." Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" />
                    </StackPanel>
                    <!-- Shown (Reveal) when output arrives while the user has scrolled up; returns to following. -->
                    <Button x:Name="JumpPill" Style="{StaticResource PrimaryButton}" Content="Jump to latest  ↓" FontSize="12" Padding="16,7"
                            HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,16" Visibility="Collapsed" Opacity="0"
                            ToolTip="Scroll to the newest output and keep following it" Click="JumpToLatest_Click" />
                </Grid>

                <!-- Execution log: anchored to the bottom of this column, expands upward -->
                <Border Grid.Row="2" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Background="{DynamicResource Panel}">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top">
                            <ToggleButton x:Name="LogToggle" Style="{StaticResource BlockHeaderToggle}" Click="LogToggle_Click" Margin="8,0,0,0" HorizontalAlignment="Left"
                                          ToolTip="Show or hide the execution log (Ctrl+L)">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="EXECUTION LOG" Style="{StaticResource SectionHeader}" VerticalAlignment="Center" />
                                    <TextBlock x:Name="LogCount" Text="0" Foreground="{DynamicResource Muted}" FontFamily="Consolas" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </ToggleButton>
                            <Button x:Name="CopyLogButton" Style="{StaticResource GhostButton}" Content="Copy full log" Padding="10,4" FontSize="11"
                                    HorizontalAlignment="Right" Margin="0,0,14,0" Click="CopyLog_Click" />
                        </Grid>
                        <TextBox x:Name="LogBox" Height="230" IsReadOnly="True" TextWrapping="NoWrap" FontFamily="Consolas" FontSize="12" Visibility="Collapsed"
                                 Margin="14,0,14,12" Background="{DynamicResource AppBackground}"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
                    </DockPanel>
                </Border>
            </Grid>
            </Grid>

            <GridSplitter x:Name="SplitterBar" Grid.Column="2" Width="6" HorizontalAlignment="Stretch" ResizeDirection="Columns"
                          Background="{DynamicResource Hover}" ShowsPreview="False" DragCompleted="Splitter_DragCompleted" />

            <!-- Right column: model details -->
            <Border x:Name="DetailsPanel" Grid.Column="3" Background="{DynamicResource Panel}">
                <ScrollViewer x:Name="DetailsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              MouseMove="Drag_Move" MouseLeftButtonUp="Drag_Up" LostMouseCapture="Drag_Up">
                    <StackPanel Margin="17">
                        <DockPanel Margin="0,0,0,12">
                            <ToggleButton x:Name="CompactToggle" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" Click="Compact_Click"
                                          ToolTip="Compact view: small square cards" />
                            <TextBlock DockPanel.Dock="Right" Text="COMPACT" Style="{StaticResource SectionHeader}" FontSize="9" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock DockPanel.Dock="Left" Text="WORKER DETAILS" Style="{StaticResource SectionHeader}" VerticalAlignment="Center" />
                            <Button x:Name="PresetsButton" Style="{StaticResource GhostButton}" Content="Presets  &#x25BE;" FontSize="11" Padding="9,3"
                                    Margin="10,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Click="Presets_Click"
                                    ToolTip="Save, apply or delete named sets of workers and their settings" />
                        </DockPanel>
                        <ItemsControl x:Name="CardsList" ItemTemplate="{StaticResource RoleCardTemplate}" />
                        <Button x:Name="AddWorkerButton" Content="+  Add worker" Margin="0,10,0,0" Click="AddWorker_Click" ToolTip="Add a worker with a custom title and model" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
            <!-- Chat: replaces the work area (the splitter and worker cards stay) -->
            <Grid x:Name="ChatView" Grid.Column="1" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DockPanel Margin="20,16,20,8" LastChildFill="False">
                    <TextBlock Text="CHAT" Style="{StaticResource SectionHeader}" VerticalAlignment="Center" />
                    <Button x:Name="NewChatButton" DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="New chat" Padding="10,4" FontSize="11"
                            Click="NewChat_Click" ToolTip="Clear the conversation" />
                    <Border DockPanel.Dock="Right" Margin="0,0,10,0" Padding="2" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Border}"
                            BorderThickness="1" CornerRadius="{DynamicResource ControlRadius}">
                        <StackPanel Orientation="Horizontal">
                            <ToggleButton x:Name="ChatSingleToggle" Style="{StaticResource SegToggle}" Content="Single" Tag="single" Click="ChatMode_Click"
                                          ToolTip="Message one worker" AutomationProperties.Name="Single worker mode" />
                            <ToggleButton x:Name="ChatMultiToggle" Style="{StaticResource SegToggle}" Content="Multi" Tag="multi" Click="ChatMode_Click"
                                          ToolTip="Planner → Implementer → Reviewer, answering with the reviewed result" AutomationProperties.Name="Multi-worker mode" />
                        </StackPanel>
                    </Border>
                    <ToggleButton x:Name="ChatKeepToggle" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" IsChecked="True" Click="ChatKeep_Click" VerticalAlignment="Center" Margin="0,0,16,0"
                                  ToolTip="On: models stay loaded between messages, so replies start faster (they are unloaded when the app closes). Off: each reply unloads the models it loaded, freeing GPU memory."
                                  AutomationProperties.Name="Keep models loaded" />
                    <TextBlock DockPanel.Dock="Right" Text="Keep models loaded" FontSize="12" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0"
                               ToolTip="{Binding ToolTip, ElementName=ChatKeepToggle}" />
                </DockPanel>
                <Grid Grid.Row="1">
                    <ScrollViewer x:Name="ChatScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,2,0" ScrollChanged="ChatScroll_ScrollChanged">
                        <StackPanel x:Name="ChatPanel" Margin="20,0,12,12" />
                    </ScrollViewer>
                    <StackPanel x:Name="ChatEmpty" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock Text="Start a conversation" FontFamily="{StaticResource DisplayFont}" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,6" />
                        <TextBlock Text="Use + to pick a worker, or switch to Multi to run the whole chain." Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" />
                    </StackPanel>
                    <Button x:Name="ChatJumpPill" Style="{StaticResource PrimaryButton}" Content="Jump to latest  ↓" FontSize="12" Padding="16,7"
                            HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,12" Visibility="Collapsed" Opacity="0"
                            ToolTip="Scroll to the newest reply and keep following it" Click="ChatJump_Click" />
                </Grid>
                <Border Grid.Row="2" Style="{StaticResource ChatBox}" Margin="20,4,20,16">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Button x:Name="ChatPlus" Style="{StaticResource GhostButton}" Content="+" FontSize="20" Width="34" Height="34" Padding="0,0,0,2"
                                    VerticalAlignment="Bottom" Click="ChatPlus_Click" ToolTip="Choose which worker to message" AutomationProperties.Name="Choose worker" />
                            <TextBox x:Name="ChatInput" Grid.Column="1" Style="{StaticResource ChatInput}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="34" MaxHeight="170"
                                     VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Center" Margin="4,0,8,0"
                                     PreviewKeyDown="ChatInput_PreviewKeyDown" TextChanged="ChatInput_TextChanged" AutomationProperties.Name="Message" />
                            <Button x:Name="ChatStop" Grid.Column="2" Style="{StaticResource GhostButton}" Width="34" Height="34" Padding="0" Margin="0,0,6,0"
                                    VerticalAlignment="Bottom" Visibility="Collapsed" Click="StopWork_Click" ToolTip="Stop (Ctrl+Shift+X)" AutomationProperties.Name="Stop">
                                <Rectangle Width="11" Height="11" RadiusX="2" RadiusY="2" Fill="{DynamicResource TextPrimary}" />
                            </Button>
                            <Button x:Name="ChatSend" Grid.Column="3" Style="{StaticResource PrimaryButton}" Content="Send" Width="76" Height="34" Padding="0"
                                    VerticalAlignment="Bottom" Click="ChatSend_Click" />
                        </Grid>
                        <DockPanel Grid.Row="1" Margin="4,6,2,0">
                            <Button x:Name="ChatTargetChip" DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Background="{DynamicResource Hover}"
                                    Foreground="{DynamicResource TextPrimary}" FontSize="11" Padding="11,3" Click="ChatTarget_Click" ToolTip="Which worker receives your message" />
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="-4,0,8,0">
                                <ToggleButton x:Name="ChatSearchToggle" Style="{StaticResource ChipToggle}" Tag="search" Click="ExtraToggle_Click" AutomationProperties.Name="Search"
                                              ToolTip="Let the worker search the web (DuckDuckGo) and read the pages it finds">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE774;" Style="{StaticResource RailGlyph}" FontSize="11" Margin="0,0,5,0" /><TextBlock Text="Search" /></StackPanel>
                                </ToggleButton>
                                <ToggleButton x:Name="ChatToolsToggle" Style="{StaticResource ChipToggle}" Tag="tools" Click="ExtraToggle_Click" AutomationProperties.Name="Tools"
                                              ToolTip="Give the worker utilities: calculator, current date and time, and reading a web page by URL">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE943;" Style="{StaticResource RailGlyph}" FontSize="11" Margin="0,0,5,0" /><TextBlock Text="Tools" /></StackPanel>
                                </ToggleButton>
                                <ToggleButton x:Name="ChatSkillsButton" Style="{StaticResource ChipToggle}" Click="Skills_Click" AutomationProperties.Name="Skills"
                                              ToolTip="Skills the worker may load: folders with a SKILL.md in the skills folder">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8F1;" Style="{StaticResource RailGlyph}" FontSize="11" Margin="0,0,5,0" /><TextBlock Text="Skills  ▾" /></StackPanel>
                                </ToggleButton>
                            </StackPanel>
                            <TextBlock x:Name="ChatHint" Text="Enter to send  ·  Shift+Enter for a new line" Foreground="{DynamicResource Muted}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                    </Grid>
                </Border>
            </Grid>
            <!-- Options -->
            <ScrollViewer x:Name="OptionsView" Grid.Column="1" Grid.ColumnSpan="3" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="40,28" MaxWidth="760" HorizontalAlignment="Left">
                    <TextBlock Text="OPTIONS" Style="{StaticResource SectionHeader}" />
                    <TextBlock Text="Theme" FontFamily="{StaticResource DisplayFont}" FontSize="20" FontWeight="SemiBold" Margin="0,16,0,0" />
                    <RadioButton x:Name="ThemeFlatRadio" GroupName="Theme" Content="Flat — modern, rounded, borderless dark theme (default)" Margin="0,14,0,8" Checked="Theme_Checked" />
                    <RadioButton x:Name="ThemeGoldRadio" GroupName="Theme" Content="Track Gold — the original dark gold theme" Margin="0,0,0,8" Checked="Theme_Checked" />
                    <RadioButton x:Name="ThemeGlassRadio" GroupName="Theme" Content="Liquid Glass — translucent blue modern theme" Margin="0,0,0,8" Checked="Theme_Checked" />
                    <RadioButton x:Name="ThemeOledRadio" GroupName="Theme" Content="OLED — pure black, flat, purple accents" Checked="Theme_Checked" />
                    <TextBlock Text="Accent colour is chosen per theme from the Accent button in the header." Foreground="{DynamicResource Muted}" Margin="0,16,0,0" />
                    <TextBlock Text="Unsloth API key" FontFamily="{StaticResource DisplayFont}" FontSize="20" FontWeight="SemiBold" Margin="0,36,0,0" />
                    <PasswordBox x:Name="ApiKeyBox" Width="460" HorizontalAlignment="Left" Margin="0,14,0,0" />
                    <TextBlock x:Name="ApiKeyHint" Text="Enter the key, or place a one-line api_key.txt beside the EXE." TextWrapping="Wrap"
                               Foreground="{DynamicResource Muted}" Margin="0,8,0,0" MaxWidth="460" HorizontalAlignment="Left" />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- A picture of the worker card being dragged follows the pointer on this layer -->
        <Canvas x:Name="DragLayer" Grid.RowSpan="4" IsHitTestVisible="False" Visibility="Collapsed">
            <Image x:Name="DragGhost" Opacity="0.85" />
        </Canvas>

        <!-- Toasts (MainWindow.Toast): newest at the bottom, just above the status bar -->
        <StackPanel x:Name="ToastStack" Grid.Row="2" IsHitTestVisible="False" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,20,16" />

        <!-- Status bar -->
        <Border Grid.Row="3" Background="{DynamicResource TitleBackground}" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0">
            <DockPanel Margin="14,0" LastChildFill="False">
                <TextBlock x:Name="FooterRight" DockPanel.Dock="Right" Foreground="{DynamicResource Muted}" FontFamily="Consolas" FontSize="11" VerticalAlignment="Center" />
                <TextBlock x:Name="FooterLeft" Foreground="{DynamicResource Muted}" FontFamily="Consolas" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
