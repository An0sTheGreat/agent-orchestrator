<Window x:Class="AgentOrchestrator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:AgentOrchestrator"
        Title="Agent Orchestrator" Width="1400" Height="860" MinWidth="1040" MinHeight="620"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize" Icon="/Assets/app.ico"
        Background="{DynamicResource AppBackground}" Foreground="{DynamicResource TextPrimary}" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        TextOptions.TextFormattingMode="Ideal">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" CornerRadius="0"
                            GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <SolidColorBrush x:Key="AppBackground" Color="#101116" />
        <SolidColorBrush x:Key="TextPrimary" Color="#ECEEF5" />
        <SolidColorBrush x:Key="TitleBackground" Color="#101116" />
        <SolidColorBrush x:Key="Panel" Color="#16171D" />
        <SolidColorBrush x:Key="Card" Color="#1E2028" />
        <SolidColorBrush x:Key="Hover" Color="#292C36" />
        <SolidColorBrush x:Key="Border" Color="#242630" />
        <SolidColorBrush x:Key="Muted" Color="#8E93A6" />
        <SolidColorBrush x:Key="Accent" Color="#4C8DFF" />
        <SolidColorBrush x:Key="AccentLight" Color="#86B3FF" />
        <SolidColorBrush x:Key="ControlBorder" Color="#00000000" />
        <SolidColorBrush x:Key="OnAccent" Color="#FFFFFF" />
        <CornerRadius x:Key="ControlRadius">17</CornerRadius>
        <CornerRadius x:Key="CardRadius">14</CornerRadius>
        <CornerRadius x:Key="PanelRadius">14</CornerRadius>
        <CornerRadius x:Key="SmallRadius">10</CornerRadius>
        <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>

        <!-- Material: raised surfaces carry a 1 px EdgeHighlight rim (light at the top edge, fading out), and fade in an
             AccentEdge rim on hover through an overlay named HoverFill. ApplyTheme / ApplyAccent build these brushes,
             and AccentGradient, AccentGlow and ShimmerBrush, so they follow the theme and accent. -->
        <Style x:Key="HoverRim" TargetType="Border">
            <Setter Property="BorderThickness" Value="1" /><Setter Property="BorderBrush" Value="{DynamicResource AccentEdge}" />
            <Setter Property="Opacity" Value="0" /><Setter Property="IsHitTestVisible" Value="False" />
        </Style>

        <!-- State motion shared by the control templates: a per-control overlay named HoverFill fades in and out,
             and a template root named Root carrying a ScaleTransform shrinks slightly while pressed.
             Only Opacity and RenderTransform are animated; the shared theme brushes never are. -->
        <Storyboard x:Key="HoverIn"><DoubleAnimation Storyboard.TargetName="HoverFill" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" /></Storyboard>
        <Storyboard x:Key="HoverOut"><DoubleAnimation Storyboard.TargetName="HoverFill" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" /></Storyboard>
        <Storyboard x:Key="PressIn">
            <DoubleAnimation Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleX" To="0.97" Duration="0:0:0.08" />
            <DoubleAnimation Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleY" To="0.97" Duration="0:0:0.08" />
        </Storyboard>
        <Storyboard x:Key="PressOut">
            <DoubleAnimation Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.12" />
            <DoubleAnimation Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.12" />
        </Storyboard>

        <Style TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="Background" Value="{DynamicResource Card}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform><ScaleTransform x:Name="RootScale" /></Grid.RenderTransform>
                            <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{DynamicResource ControlRadius}">
                                <Grid>
                                    <Border x:Name="HoverFill" Background="{DynamicResource Hover}" CornerRadius="{DynamicResource ControlRadius}" Opacity="0" />
                                    <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource HoverIn}" /></Trigger.EnterActions>
                                <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource HoverOut}" /></Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource PressIn}" /></Trigger.EnterActions>
                                <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource PressOut}" /></Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource AccentGradient}" />
            <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
            <Setter Property="BorderBrush" Value="{DynamicResource EdgeHighlight}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform><ScaleTransform x:Name="RootScale" /></Grid.RenderTransform>
                            <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{DynamicResource ControlRadius}">
                                <Grid>
                                    <!-- Hover lays a light sheen over the accent gradient, brightening it toward the top. -->
                                    <Border x:Name="HoverFill" CornerRadius="{DynamicResource ControlRadius}" Opacity="0">
                                        <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#40FFFFFF" Offset="0" /><GradientStop Color="#14FFFFFF" Offset="1" /></LinearGradientBrush></Border.Background>
                                    </Border>
                                    <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource AccentLight}" />
                                <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource HoverIn}" /></Trigger.EnterActions>
                                <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource HoverOut}" /></Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource PressIn}" /></Trigger.EnterActions>
                                <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource PressOut}" /></Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
        </Style>
        <Style x:Key="TitleButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="46" /><Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" /><Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource TitleButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Root" Background="Transparent" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform><ScaleTransform x:Name="RootScale" /></Grid.RenderTransform>
                            <Border x:Name="HoverFill" Background="#C42B1C" Opacity="0" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="White" />
                                <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource HoverIn}" /></Trigger.EnterActions>
                                <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource HoverOut}" /></Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource PressIn}" /></Trigger.EnterActions>
                                <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource PressOut}" /></Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="11" /><Setter Property="Foreground" Value="{DynamicResource Muted}" />
        </Style>
        <Style x:Key="SubHeader" TargetType="TextBlock" BasedOn="{StaticResource SectionHeader}">
            <Setter Property="Margin" Value="8,24,0,8" />
        </Style>
        <!-- Large figures on the worker cards: tabular digits so streaming numbers do not jitter. -->
        <Style x:Key="CardValue" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" /><Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Typography.NumeralAlignment" Value="Tabular" />
            <Setter Property="Margin" Value="0,1,0,0" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" /><Setter Property="Background" Value="{DynamicResource Card}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}" /><Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,8" /><Setter Property="CaretBrush" Value="{DynamicResource AccentLight}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Field" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource ControlRadius}"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Hidden" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Field" Property="BorderBrush" Value="{DynamicResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Field" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" /><Setter Property="Background" Value="{DynamicResource Card}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}" /><Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,8" /><Setter Property="CaretBrush" Value="{DynamicResource AccentLight}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="Field" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource ControlRadius}"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Hidden" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Field" Property="BorderBrush" Value="{DynamicResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Field" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <BulletDecorator Background="Transparent">
                            <BulletDecorator.Bullet>
                                <Grid Width="14" Height="14" Margin="0,0,7,0">
                                    <Ellipse x:Name="Ring" Fill="{DynamicResource Card}" Stroke="{DynamicResource Muted}" StrokeThickness="1.5" />
                                    <Ellipse x:Name="Dot" Width="7" Height="7" Fill="{DynamicResource AccentLight}" Visibility="Collapsed" />
                                </Grid>
                            </BulletDecorator.Bullet>
                            <ContentPresenter VerticalAlignment="Center" Margin="4,0,0,0" />
                        </BulletDecorator>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource AccentLight}" />
                                <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource TextPrimary}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Icon in the collapsed sidebar rail; takes its colour from the button that hosts it. -->
        <Style x:Key="RailGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- A button that is only its content (the Context card's header row: the card itself shows the hover) -->
        <Style x:Key="BareButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" /><Setter Property="Cursor" Value="Hand" /><Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter /></Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Sliders (the worker settings' context length and GPU layers): a thin track, accent fill up to a white knob. -->
        <Style x:Key="SliderPart" TargetType="RepeatButton">
            <Setter Property="OverridesDefaultStyle" Value="True" /><Setter Property="Focusable" Value="False" /><Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Height="4" CornerRadius="2" Background="{TemplateBinding Background}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Slider">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="22" Background="Transparent">
                            <Border Height="4" CornerRadius="2" Background="{DynamicResource Hover}" VerticalAlignment="Center" />
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource SliderPart}" Background="{DynamicResource Accent}" Command="Slider.DecreaseLarge" />
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource SliderPart}" Background="Transparent" Command="Slider.IncreaseLarge" />
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="16" Height="16">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb"><Ellipse Fill="White" Stroke="{DynamicResource Border}" StrokeThickness="1" /></ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ToggleSwitch" TargetType="ToggleButton">
            <Setter Property="Width" Value="42" /><Setter Property="Height" Value="23" /><Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <Border Background="{DynamicResource Card}" BorderBrush="{DynamicResource Border}"
                                    BorderThickness="1" CornerRadius="12" />
                            <Border x:Name="TrackOn" Background="{DynamicResource Accent}" BorderBrush="{DynamicResource AccentLight}"
                                    BorderThickness="1" CornerRadius="12" Opacity="0" />
                            <!-- The knob slides the 19 px between its off (left 3) and on (right 3) positions in the 42 px track. -->
                            <Grid x:Name="Knob" Width="17" Height="17" HorizontalAlignment="Left" Margin="3,0,0,0">
                                <Grid.RenderTransform><TranslateTransform x:Name="KnobShift" /></Grid.RenderTransform>
                                <Ellipse Fill="{DynamicResource Muted}" />
                                <Ellipse x:Name="KnobOn" Fill="White" Opacity="0" />
                            </Grid>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="KnobShift" Storyboard.TargetProperty="X" To="19" Duration="0:0:0.16">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="TrackOn" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.16" />
                                            <DoubleAnimation Storyboard.TargetName="KnobOn" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.16" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="KnobShift" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.16">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="TrackOn" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16" />
                                            <DoubleAnimation Storyboard.TargetName="KnobOn" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ContextMenu">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="HasDropShadow" Value="False" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{DynamicResource Card}" BorderBrush="{DynamicResource Border}" BorderThickness="1"
                                CornerRadius="{DynamicResource SmallRadius}" Padding="5">
                            <ScrollViewer MaxHeight="460" VerticalScrollBarVisibility="Auto">
                                <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MenuSeparator" TargetType="Separator">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1" Margin="8,4" Background="{DynamicResource Border}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="Padding" Value="8,7" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Row" Background="Transparent" CornerRadius="{DynamicResource SmallRadius}" Padding="{TemplateBinding Padding}" Margin="0,1">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" MinWidth="120" /></Grid.ColumnDefinitions>
                                <TextBlock x:Name="Check" Text="&#x2713;" Foreground="{DynamicResource AccentLight}" FontWeight="Bold"
                                           VerticalAlignment="Center" Visibility="Collapsed" />
                                <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="False" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="Check" Property="Visibility" Value="Visible" /></Trigger>
                            <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource Hover}" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Row" Property="Opacity" Value="0.45" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Row" Background="Transparent" CornerRadius="{DynamicResource SmallRadius}" Padding="{TemplateBinding Padding}" Margin="0,1">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource Hover}" /></Trigger>
                            <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource Hover}" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Row" Property="Opacity" Value="0.45" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Drawn like a TextBox; the list opens like the app's menus -->
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" /><Setter Property="Background" Value="{DynamicResource Card}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}" /><Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,0,28,0" /><Setter Property="Height" Value="30" /><Setter Property="MaxDropDownHeight" Value="360" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Field" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource ControlRadius}" />
                            <ContentPresenter Margin="{TemplateBinding Padding}" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              VerticalAlignment="Center" HorizontalAlignment="Left" IsHitTestVisible="False" />
                            <TextBlock Text="&#xE70D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" Foreground="{DynamicResource Muted}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" IsHitTestVisible="False" />
                            <ToggleButton Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent" /></ControlTemplate></ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False">
                                <Border Background="{DynamicResource Card}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="{DynamicResource SmallRadius}"
                                        Padding="5" Margin="0,2,0,0" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer MaxHeight="{TemplateBinding MaxDropDownHeight}" VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Field" Property="BorderBrush" Value="{DynamicResource Accent}" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NavToggle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="Padding" Value="14,8,10,8" />
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Background="Transparent">
                            <Border x:Name="HoverFill" Background="{DynamicResource Hover}" CornerRadius="{DynamicResource ControlRadius}" Opacity="0" />
                            <Border x:Name="CheckedFill" Background="{DynamicResource Card}" CornerRadius="{DynamicResource ControlRadius}" Opacity="0" />
                            <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                            <Border x:Name="Bar" Width="3" Height="16" CornerRadius="2" Background="{DynamicResource Accent}"
                                    HorizontalAlignment="Left" Margin="4,0,0,0" Opacity="0" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource HoverIn}" /></Trigger.EnterActions>
                                <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource HoverOut}" /></Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource AccentLight}" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="CheckedFill" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15" />
                                            <DoubleAnimation Storyboard.TargetName="Bar" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="CheckedFill" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" />
                                            <DoubleAnimation Storyboard.TargetName="Bar" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Sidebar list rows that act rather than select (New chat, project headers, "…"): NavToggle's hover, no checked state. -->
        <Style x:Key="SidebarRow" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="Padding" Value="14,6,10,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Border x:Name="HoverFill" Background="{DynamicResource Hover}" CornerRadius="{DynamicResource ControlRadius}" Opacity="0" />
                            <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource HoverIn}" /></Trigger.EnterActions>
                                <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource HoverOut}" /></Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Chat: segmented toggle, the borderless message box and the rounded composer around it. -->
        <Style x:Key="SegToggle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="Padding" Value="15,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Seg" Background="Transparent" CornerRadius="{DynamicResource ControlRadius}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource TextPrimary}" /></Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Seg" Property="Background" Value="{DynamicResource AccentGradient}" />
                                <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- The composer's Search / Tools / Skills chips: muted text, accent text when on. -->
        <Style x:Key="ChipToggle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Chip" Background="Transparent" CornerRadius="{DynamicResource ControlRadius}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="{DynamicResource Hover}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="{DynamicResource Hover}" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentLight}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ChatInput" TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="CaretBrush" Value="{DynamicResource AccentLight}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="4,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Field" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Field" Property="Opacity" Value="0.5" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ChatBox" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Card}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource PanelRadius}" />
            <Setter Property="Padding" Value="10,8,10,8" />
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource Accent}" /></Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="10" /><Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" /></Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="{DynamicResource Muted}" CornerRadius="3" Margin="2,0" Opacity="0.6" /></ControlTemplate></Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" /></Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto" /><Setter Property="Height" Value="8" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Grid Background="Transparent">
                                    <Track x:Name="PART_Track">
                                        <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageLeftCommand" Opacity="0" /></Track.DecreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb>
                                                <Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="{DynamicResource Muted}" CornerRadius="3" Margin="0,2" Opacity="0.6" /></ControlTemplate></Thumb.Template>
                                            </Thumb>
                                        </Track.Thumb>
                                        <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageRightCommand" Opacity="0" /></Track.IncreaseRepeatButton>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Collapsible thinking / tool sections -->
        <Style x:Key="BlockHeaderToggle" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Background="Transparent">
                            <Border x:Name="HoverFill" Background="{DynamicResource Hover}" CornerRadius="{DynamicResource SmallRadius}" Opacity="0" />
                            <DockPanel Margin="4,5">
                                <Grid DockPanel.Dock="Left" Width="16">
                                    <TextBlock x:Name="Glyph" Text="&#x25B8;" Foreground="{DynamicResource Muted}" HorizontalAlignment="Left" VerticalAlignment="Center"
                                               RenderTransformOrigin="0.5,0.5">
                                        <TextBlock.RenderTransform><RotateTransform x:Name="GlyphTurn" /></TextBlock.RenderTransform>
                                    </TextBlock>
                                </Grid>
                                <ContentPresenter VerticalAlignment="Center" />
                            </DockPanel>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource HoverIn}" /></Trigger.EnterActions>
                                <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource HoverOut}" /></Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="GlyphTurn" Storyboard.TargetProperty="Angle" To="90" Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="GlyphTurn" Storyboard.TargetProperty="Angle" To="0" Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- A collapsible section (thinking, tool call, response): plain text without a card, like other AI chat apps. -->
        <Style x:Key="BlockExpander" TargetType="Expander">
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <Grid>
                            <DockPanel>
                                <Grid DockPanel.Dock="Top">
                                    <ToggleButton Style="{StaticResource BlockHeaderToggle}"
                                                  IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                        <ContentPresenter ContentSource="Header" />
                                    </ToggleButton>
                                    <!-- Copy this section; shown while the section is hovered (only then can it be reached). -->
                                    <Button x:Name="SectionCopy" Focusable="False" Content="Copy" FontSize="11" Padding="10,3" Margin="0,0,8,0" Opacity="0"
                                            HorizontalAlignment="Right" VerticalAlignment="Center" ToolTip="Copy this section" Click="SectionCopy_Click" />
                                </Grid>
                                <ContentPresenter x:Name="Body" Margin="22,2,8,8" Visibility="Collapsed">
                                    <ContentPresenter.RenderTransform><TranslateTransform x:Name="BodyShift" /></ContentPresenter.RenderTransform>
                                </ContentPresenter>
                            </DockPanel>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="SectionCopy" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" /></Storyboard></BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="SectionCopy" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" /></Storyboard></BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <!-- Opening fades and slides the body in; closing stays instant. -->
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="Body" Property="Visibility" Value="Visible" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Body" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.18" />
                                            <DoubleAnimation Storyboard.TargetName="BodyShift" Storyboard.TargetProperty="Y" From="-6" To="0" Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <BooleanToVisibilityConverter x:Key="BoolVis" />
        <Style x:Key="Chip" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Hover}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="9,3" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>

        <!-- The worker's activity dot: grey when idle, the accent with a pulse while it works (worker tabs, worker rail). -->
        <DataTemplate x:Key="ActivityDot">
            <Grid Width="26" Height="26">
                <Ellipse Width="12" Height="12" Fill="{DynamicResource Accent}" Opacity="0" RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform><ScaleTransform x:Name="RingScale" /></Ellipse.RenderTransform>
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard x:Name="RingPulse">
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.55" To="0" Duration="0:0:1.3" />
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="1" To="2.1" Duration="0:0:1.3" />
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="1" To="2.1" Duration="0:0:1.3" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                    <DataTrigger.ExitActions><StopStoryboard BeginStoryboardName="RingPulse" /></DataTrigger.ExitActions>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <Ellipse Width="12" Height="12" RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform><ScaleTransform x:Name="CoreScale" /></Ellipse.RenderTransform>
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="#4A4D57" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                    <Setter Property="Fill" Value="{DynamicResource Accent}" />
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard x:Name="CorePulse">
                                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="0.8" To="1.2" Duration="0:0:0.65" />
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="0.8" To="1.2" Duration="0:0:0.65" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                    <DataTrigger.ExitActions><StopStoryboard BeginStoryboardName="CorePulse" /></DataTrigger.ExitActions>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
            </Grid>
        </DataTemplate>

        <!-- One worker tab (MainWindow.WorkerTabs.cs): title and activity dot, model, then tok/s and task / turn tokens.
             WorkerTabWidth fits three tabs across the column, down to a minimum; narrower columns scroll the strip. -->
        <DataTemplate x:Key="WorkerTabTemplate">
            <Button Tag="WorkerTab" Width="{DynamicResource WorkerTabWidth}" Margin="0,0,6,0" Click="WorkerTab_Click" Cursor="Hand" FocusVisualStyle="{x:Null}"
                    Foreground="{DynamicResource TextPrimary}" AutomationProperties.Name="{Binding Title}" ToolTip="{Binding TabTip}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="TabBox" Background="{DynamicResource Card}" BorderBrush="{DynamicResource EdgeHighlight}" BorderThickness="1"
                                CornerRadius="{DynamicResource SmallRadius}" Padding="9,6,6,7">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabBox" Property="Background" Value="{DynamicResource Hover}" /></Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="TabBox" Property="Background" Value="{DynamicResource Hover}" />
                                <Setter TargetName="TabBox" Property="BorderBrush" Value="{DynamicResource Accent}" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <StackPanel>
                    <DockPanel>
                        <ContentPresenter DockPanel.Dock="Right" Content="{Binding}" ContentTemplate="{StaticResource ActivityDot}" Margin="0,-6,-6,-6" />
                        <TextBlock Text="{Binding Title}" Style="{StaticResource SectionHeader}" FontSize="9.5" Foreground="{DynamicResource AccentLight}"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Title}" />
                    </DockPanel>
                    <TextBlock Tag="Covers" FontSize="9.5" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Covers}"
                               Visibility="{Binding HasCovers, Converter={StaticResource BoolVis}}">
                        <Run Text="Covers " /><Run Text="{Binding Covers, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Text="{Binding ModelName}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                    <TextBlock Text="&#x26A0; Setup incomplete" FontSize="10" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" ToolTip="{Binding SetupTip}"
                               Visibility="{Binding HasSetupProblem, Converter={StaticResource BoolVis}}" />
                    <TextBlock Text="{Binding TokensPerSec}" FontSize="11" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" TextTrimming="CharacterEllipsis" Margin="0,5,0,0" />
                    <TextBlock FontSize="10.5" Foreground="{DynamicResource Muted}" Typography.NumeralAlignment="Tabular">
                        <Run Text="{Binding TaskTokensShort, Mode=OneWay}" /><Run Text=" task · " /><Run Text="{Binding TurnTotalShort, Mode=OneWay}" /><Run Text=" turn" />
                    </TextBlock>
                </StackPanel>
            </Button>
        </DataTemplate>

        <!-- The worker rail's hover card (MainWindow.WorkerRail.cs): the worker's live figures; the gear opens its tab. -->
        <DataTemplate x:Key="RailCardTemplate">
            <Grid x:Name="CardRoot" Tag="CardRoot">
            <Border Background="{DynamicResource Card}" CornerRadius="{DynamicResource PanelRadius}" Padding="16,14" BorderThickness="1" BorderBrush="{DynamicResource EdgeHighlight}">
                <StackPanel>
                    <DockPanel>
                        <Border DockPanel.Dock="Right" CornerRadius="9" Padding="9,2" VerticalAlignment="Center">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource Hover}" />
                                    <Style.Triggers><DataTrigger Binding="{Binding IsActive}" Value="True"><Setter Property="Background" Value="{DynamicResource Accent}" /></DataTrigger></Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding Status}" FontSize="10" FontFamily="Consolas" FontWeight="Bold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource Muted}" />
                                        <Style.Triggers><DataTrigger Binding="{Binding IsActive}" Value="True"><Setter Property="Foreground" Value="{DynamicResource OnAccent}" /></DataTrigger></Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                        <TextBlock Text="{Binding Title}" Style="{StaticResource SectionHeader}" Foreground="{DynamicResource AccentLight}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </DockPanel>

                    <TextBlock Text="MODEL" Style="{StaticResource SectionHeader}" FontSize="10" Margin="0,14,0,0" />
                    <TextBlock Text="{Binding ModelName}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding ModelName}" Margin="0,2,0,0" />

                    <TextBlock Text="&#x26A0; Setup incomplete" FontSize="10.5" Foreground="{DynamicResource Muted}" Margin="0,4,0,0" ToolTip="{Binding SetupTip}" Visibility="{Binding HasSetupProblem, Converter={StaticResource BoolVis}}" />
                    <TextBlock Text="WEIGHTS / QUANTIZATION" Style="{StaticResource SectionHeader}" FontSize="10" Margin="0,14,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Border Style="{StaticResource Chip}"><TextBlock Text="{Binding Weights}" FontSize="12" /></Border>
                        <Border Style="{StaticResource Chip}"><TextBlock Text="{Binding Quant}" FontSize="12" /></Border>
                    </StackPanel>

                    <TextBlock Text="TOKENS / SEC" Style="{StaticResource SectionHeader}" FontSize="10" Margin="0,14,0,0" />
                    <TextBlock Text="{Binding TokensPerSec}" Style="{StaticResource CardValue}" />
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <StackPanel ToolTip="Tokens this worker used in the last completed task (prompt + generated)">
                            <TextBlock Text="TASK TOKENS" Style="{StaticResource SectionHeader}" FontSize="10" />
                            <TextBlock Text="{Binding TaskTokens}" Style="{StaticResource CardValue}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="TURN TOKENS" Style="{StaticResource SectionHeader}" FontSize="10" />
                            <TextBlock Text="{Binding TurnTotal}" Style="{StaticResource CardValue}" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{Binding TurnDetail}" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,2,0,0" />
                </StackPanel>
            </Border>
            <Button Style="{StaticResource GhostButton}" Tag="ModelSettingsGear" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,8,8" Padding="5,3"
                    ToolTip="Model settings: show this worker's tab" AutomationProperties.Name="Model settings" Click="RailCardSettings_Click">
                <TextBlock Text="&#xE713;" Style="{StaticResource RailGlyph}" FontSize="13" />
            </Button>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="34" /><RowDefinition Height="0" /><RowDefinition Height="*" /><RowDefinition Height="34" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>

        <Grid x:Name="ThemeBackdrop" Grid.RowSpan="4" Grid.ColumnSpan="2" Visibility="Collapsed" IsHitTestVisible="False" Background="{DynamicResource AppBackground}">
            <Ellipse Width="820" Height="820" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-260,-330,0,0">
                <Ellipse.Fill><RadialGradientBrush><GradientStop x:Name="GlassA1" Color="#70558CFF" Offset="0" /><GradientStop x:Name="GlassA2" Color="#00465A9C" Offset="1" /></RadialGradientBrush></Ellipse.Fill>
            </Ellipse>
            <Ellipse Width="900" Height="900" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-350,-410">
                <Ellipse.Fill><RadialGradientBrush><GradientStop x:Name="GlassB1" Color="#5064D8C4" Offset="0" /><GradientStop x:Name="GlassB2" Color="#003C6A73" Offset="1" /></RadialGradientBrush></Ellipse.Fill>
            </Ellipse>
        </Grid>

        <!-- Title bar -->
        <Border x:Name="TitleBar" Grid.Row="0" Grid.Column="1" Background="{DynamicResource TitleBackground}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" MouseMove="TitleBar_MouseMove" MouseLeftButtonUp="TitleBar_MouseLeftButtonUp">
            <Grid>
            <!-- While a run or reply is in progress a light sweeps along the title bar's lower edge (SetActivity starts and stops it).
                 The Viewbox stretches a fixed 100-unit track to the bar's width, so the sweep needs no resize handling. -->
                <!-- The open chat's title, like other chat apps; its menu is the sidebar row's (RefreshTitleChat). -->
                <Button x:Name="TitleChatButton" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0"
                        Padding="8,3" Visibility="Collapsed" Click="TitleChat_Click" ToolTip="Chat options">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="TitleChatText" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" MaxWidth="420" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <TextBlock Text="&#xE70D;" Style="{StaticResource RailGlyph}" FontSize="10" Margin="8,1,0,0" Foreground="{DynamicResource Muted}" />
                    </StackPanel>
                </Button>
                <Viewbox x:Name="Shimmer" Stretch="Fill" Height="2" VerticalAlignment="Bottom" Margin="0,0,0,-1" Opacity="0" IsHitTestVisible="False">
                <Canvas Width="100" Height="2" ClipToBounds="True">
                    <Rectangle Width="34" Height="2" Fill="{DynamicResource ShimmerBrush}">
                        <Rectangle.RenderTransform><TranslateTransform x:Name="ShimmerShift" X="-34" /></Rectangle.RenderTransform>
                    </Rectangle>
                </Canvas>
            </Viewbox>
                <Border x:Name="StatusPill" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="9,2,11,2" Visibility="Collapsed"
                        Background="{DynamicResource Card}" BorderBrush="{DynamicResource EdgeHighlight}" BorderThickness="1"
                        CornerRadius="{DynamicResource ControlRadius}">
                    <StackPanel Orientation="Horizontal">
                        <Grid Width="9" Height="9" Margin="0,0,8,0" VerticalAlignment="Center">
                            <Ellipse x:Name="StatusRing" Fill="{Binding Fill, ElementName=StatusDot}" Opacity="0" RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform><ScaleTransform x:Name="StatusRingScale" /></Ellipse.RenderTransform>
                            </Ellipse>
                            <Ellipse x:Name="StatusDot" Fill="#667085" />
                        </Grid>
                        <TextBlock x:Name="StatusText" Text="Ready" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="BrowserButton" Style="{StaticResource TitleButton}" Click="Browser_Click"
                            ToolTip="Browser: links and the pages the model reads open here" AutomationProperties.Name="Browser">
                        <TextBlock Text="&#xE774;" Style="{StaticResource RailGlyph}" FontSize="13" />
                    </Button>
                    <Button Style="{StaticResource TitleButton}" Content="─" Click="Minimize_Click" />
                    <Button x:Name="MaximizeButton" Style="{StaticResource TitleButton}" Content="□" Click="Maximize_Click" />
                    <Button Style="{StaticResource CloseButton}" Content="×" Click="Close_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main area: sidebar, the Code / Chat / Options view, worker cards -->
        <!-- Left-side navigation, the full height of the window beside the title bar. Its width is animated; it collapses to an icon rail. -->
        <Border x:Name="SidePane" Grid.Column="0" Grid.RowSpan="4" Width="260" ClipToBounds="True" Background="{DynamicResource NavBackground}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid x:Name="SidebarFull" Width="259" HorizontalAlignment="Left">
                    <Grid.RowDefinitions><RowDefinition Height="46" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <!-- Top strip, level with the title bar (it drags the window too): collapse on the left, the Chat / Code switch on the right. -->
                    <Grid Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" MouseMove="TitleBar_MouseMove" MouseLeftButtonUp="TitleBar_MouseLeftButtonUp">
                        <Button x:Name="SidebarCollapseButton" Style="{StaticResource GhostButton}" Width="28" Height="26" Padding="0" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0"
                                Click="SidebarToggle_Click" ToolTip="Collapse sidebar (Ctrl+B)" AutomationProperties.Name="Collapse sidebar (Ctrl+B)">
                            <TextBlock Text="&#xE76B;" Style="{StaticResource RailGlyph}" FontSize="12" />
                        </Button>
                        <Border HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" Padding="2" Background="{DynamicResource Card}"
                                BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="{DynamicResource ControlRadius}">
                            <StackPanel Orientation="Horizontal">
                                <ToggleButton x:Name="NavChat" Style="{StaticResource SegToggle}" Padding="7,5" Click="Nav_Click" Tag="Chat" ToolTip="Chat with the workers (Ctrl+1)" AutomationProperties.Name="Chat">
                                    <TextBlock Text="&#xE8BD;" Style="{StaticResource RailGlyph}" FontSize="19" />
                                </ToggleButton>
                                <ToggleButton x:Name="NavCode" Style="{StaticResource SegToggle}" Padding="7,5" IsChecked="True" Click="Nav_Click" Tag="Code" ToolTip="Code in a folder with the workers (Ctrl+2)" AutomationProperties.Name="Code">
                                    <TextBlock Text="&#xE943;" Style="{StaticResource RailGlyph}" FontSize="19" />
                                </ToggleButton>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="12,4,12,12">
                            <!-- The saved Code conversations, built by RefreshSidebarList (MainWindow.Sidebar.cs). -->
                            <StackPanel x:Name="SidebarList" />
                        </StackPanel>
                    </ScrollViewer>
                    <!-- Profile (MainWindow.Profile.cs): below an accent rule, the picture and name open the profile card; the gear opens Settings. -->
                    <StackPanel Grid.Row="2">
                        <Border Height="1" Margin="14,0" Background="{DynamicResource Accent}" Opacity="0.55">
                            <Border.OpacityMask>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="Transparent" Offset="0" /><GradientStop Color="Black" Offset="0.5" /><GradientStop Color="Transparent" Offset="1" />
                                </LinearGradientBrush>
                            </Border.OpacityMask>
                        </Border>
                        <DockPanel Margin="8,8,8,10">
                            <Button x:Name="NavOptions" DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Foreground="{DynamicResource TextPrimary}" Width="36" Height="36" Padding="0"
                                    VerticalAlignment="Center" Click="Settings_Click" ToolTip="Settings (Ctrl+3)" AutomationProperties.Name="Settings">
                                <TextBlock Text="&#xE713;" Style="{StaticResource RailGlyph}" FontSize="17" />
                            </Button>
                            <Button x:Name="ProfileButton" Style="{StaticResource GhostButton}" Padding="6,4" Margin="0,0,4,0" HorizontalContentAlignment="Stretch"
                                    Click="Profile_Click" ToolTip="Profile and usage" AutomationProperties.Name="Profile">
                                <DockPanel>
                                    <ContentControl x:Name="ProfileAvatar" Width="30" Height="30" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <TextBlock DockPanel.Dock="Right" Text="&#xE70E;" Style="{StaticResource RailGlyph}" FontSize="10" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Name="ProfileNameText" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock x:Name="ProfileTokensText" FontSize="11" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DockPanel>
                            </Button>
                        </DockPanel>
                    </StackPanel>
                </Grid>
                <StackPanel x:Name="SidebarRail" Width="53" HorizontalAlignment="Left" Margin="0,4,0,0" Visibility="Collapsed">
                    <Button x:Name="SidebarExpandButton" Style="{StaticResource GhostButton}" Height="28" Margin="12,0,12,14" Padding="0" Click="SidebarToggle_Click" ToolTip="Expand sidebar (Ctrl+B)" AutomationProperties.Name="Expand sidebar (Ctrl+B)">
                        <TextBlock Text="&#xE76C;" Style="{StaticResource RailGlyph}" FontSize="12" />
                    </Button>
                    <Button Style="{StaticResource GhostButton}" Height="28" Margin="12,0,12,14" Padding="0" Click="CodeNew_Click" ToolTip="New chat" AutomationProperties.Name="New chat">
                        <TextBlock Text="&#xE710;" Style="{StaticResource RailGlyph}" FontSize="12" />
                    </Button>
                    <ToggleButton Style="{StaticResource NavToggle}" Height="38" Padding="0" Margin="6,0,6,4" Tag="Chat" Click="Nav_Click" ToolTip="Chat (Ctrl+1)" AutomationProperties.Name="Chat (Ctrl+1)"
                                  IsChecked="{Binding IsChecked, ElementName=NavChat, Mode=TwoWay}">
                        <TextBlock Text="&#xE8F2;" Style="{StaticResource RailGlyph}" />
                    </ToggleButton>
                    <ToggleButton Style="{StaticResource NavToggle}" Height="38" Padding="0" Margin="6,0,6,4" Tag="Code" Click="Nav_Click" ToolTip="Code (Ctrl+2)" AutomationProperties.Name="Code (Ctrl+2)"
                                  IsChecked="{Binding IsChecked, ElementName=NavCode, Mode=TwoWay}">
                        <TextBlock Text="&#xE943;" Style="{StaticResource RailGlyph}" />
                    </ToggleButton>
                    <Button x:Name="RailSettings" Style="{StaticResource GhostButton}" Foreground="{DynamicResource TextPrimary}" Height="38" Padding="0" Margin="6,0,6,4"
                            Click="Settings_Click" ToolTip="Settings (Ctrl+3)" AutomationProperties.Name="Settings (Ctrl+3)">
                        <TextBlock Text="&#xE713;" Style="{StaticResource RailGlyph}" />
                    </Button>
                    <Button x:Name="RailProfile" Style="{StaticResource GhostButton}" Height="38" Padding="0" Margin="6,0,6,4"
                            Click="Profile_Click" ToolTip="Profile and usage" AutomationProperties.Name="Profile">
                        <ContentControl x:Name="RailAvatar" Width="26" Height="26" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid x:Name="MainView" Grid.Row="2" Grid.Column="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="380" />
                <ColumnDefinition x:Name="SplitterColumn" Width="6" />
                <ColumnDefinition x:Name="DetailsColumn" Width="340" MinWidth="260" MaxWidth="1400" />
            </Grid.ColumnDefinitions>

            <!-- Code: a conversation with a worker about a folder (MainWindow.Code.cs), or the project run's output (ShowCodeRun) -->
            <Grid x:Name="CodeView" Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /><RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DockPanel Margin="20,16,20,0" LastChildFill="False">
                    <TextBlock Text="CODE" Style="{StaticResource SectionHeader}" VerticalAlignment="Center" />
                    <TextBlock x:Name="CodeFolderText" Text="No folder" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"
                               Margin="12,0,0,0" MaxWidth="200" TextTrimming="CharacterEllipsis" />
                    <Button x:Name="CodeProjectButton" Style="{StaticResource GhostButton}" Content="Project  &#x25BE;" FontSize="11" Padding="9,3" Margin="10,0,0,0"
                            VerticalAlignment="Center" Click="CodeProject_Click" IsEnabled="False" ToolTip="PROJECT.md, task limits, extra folders and run options for this folder" />
                    <!-- Project > Folders… shows this panel in a dialog (MainWindow.Code.cs RefreshCodeFolders builds the list) -->
                    <ContentControl x:Name="CodeFoldersHost" Visibility="Collapsed">
                        <StackPanel x:Name="CodeFoldersPanel" Width="340">
                            <TextBlock Text="Folders beyond the project folder the Code worker may read or edit." TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,0,0,8" />
                            <TextBlock x:Name="CodeFoldersEmpty" Text="Choose a project folder first" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="11" Margin="8,0,0,4" />
                            <StackPanel x:Name="CodeFoldersList" />
                            <Button x:Name="AddCodeFolderButton" Content="Add folder…" Margin="0,8,0,0" Click="AddCodeFolder_Click" Visibility="Collapsed"
                                    ToolTip="Let the Code worker read or edit another folder" />
                        </StackPanel>
                    </ContentControl>
                    <Button x:Name="CodeStartButton" DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="Start project" Padding="12,4" FontSize="11"
                            Click="CodeStart_Click" ToolTip="Start or resume the project run in this folder (Ctrl+Enter)" ToolTipService.ShowOnDisabled="True" />
                    <Button x:Name="CodeNewButton" DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="New conversation" Padding="10,4" FontSize="11" Margin="0,0,8,0"
                            Click="CodeNew_Click" ToolTip="Start a new conversation" />
                    <Border DockPanel.Dock="Right" Margin="0,0,10,0" Padding="2" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Border}"
                            BorderThickness="1" CornerRadius="{DynamicResource ControlRadius}">
                        <StackPanel Orientation="Horizontal">
                            <ToggleButton x:Name="CodeConversationToggle" Style="{StaticResource SegToggle}" Content="Conversation" IsChecked="True" Click="CodeSubView_Click"
                                          ToolTip="The conversation with the worker" AutomationProperties.Name="Conversation" />
                            <ToggleButton x:Name="CodeRunToggle" Style="{StaticResource SegToggle}" Content="Run output" Tag="run" Click="CodeSubView_Click"
                                          ToolTip="Model output and the execution log of the project run" AutomationProperties.Name="Run output" />
                        </StackPanel>
                    </Border>
                    <Button x:Name="CodeContextRing" DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Padding="0" Margin="0,0,10,0" VerticalAlignment="Center"
                            Click="ContextRing_Click" AutomationProperties.Name="Context usage" />
                </DockPanel>
                <Grid x:Name="CodeChat" Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" /><RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Margin="0,8,0,0">
                        <ScrollViewer x:Name="CodeScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,2,0" ScrollChanged="ChatScroll_ScrollChanged"
                                      SizeChanged="ConversationScroll_SizeChanged">
                            <StackPanel x:Name="CodePanel" Margin="20,0,12,12" />
                        </ScrollViewer>
                        <!-- The context card pinned open by the ring (centered conversations with room beside them; MainWindow.Context.cs) -->
                        <ContentControl x:Name="CodeContextPin" HorizontalAlignment="Right" VerticalAlignment="Top" Width="280" Margin="0,0,20,0" Visibility="Collapsed" />
                        <StackPanel x:Name="CodeEmpty" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock x:Name="CodeEmptyTitle" Text="Choose a folder to start" FontFamily="{StaticResource DisplayFont}" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,6" />
                            <!-- MainWindow.Code.cs RefreshCodeFolder sets the text and buttons: no folder, a folder without PROJECT.md, or one with it -->
                            <TextBlock x:Name="CodeEmptyText" Text="Choose the working folder; the worker can read, search and edit the files in it." Foreground="{DynamicResource Muted}"
                                       HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="460" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
                                <Button x:Name="CodeEmptyChoose" Content="Choose a folder…" Style="{StaticResource PrimaryButton}" Padding="16,7" Click="CodeNew_Click" />
                                <Button x:Name="CodeEmptyInit" Content="Create PROJECT.md with a model…" Style="{StaticResource PrimaryButton}" Padding="16,7" Click="CodeEmptyInit_Click"
                                        Visibility="Collapsed" ToolTip="Pick a worker (the Planner by default); it interviews you with the init-project skill and writes PROJECT.md" />
                                <Button x:Name="CodeEmptyAddMd" Content="Add PROJECT.md…" Style="{StaticResource GhostButton}" Padding="16,7" Margin="8,0,0,0" Click="CodeEmptyAddMd_Click"
                                        Visibility="Collapsed" ToolTip="Copy a PROJECT.md you already have into this folder" />
                                <Button x:Name="CodeEmptyTemplate" Content="Start from template" Style="{StaticResource GhostButton}" Padding="16,7" Margin="8,0,0,0"
                                        Click="CodeEmptyTemplate_Click" Visibility="Collapsed" ToolTip="Copy the PROJECT.md template into this folder and open it to fill in" />
                            </StackPanel>
                        </StackPanel>
                        <Button x:Name="CodeJumpPill" Style="{StaticResource PrimaryButton}" Content="Jump to latest  ↓" FontSize="12" Padding="16,7"
                                HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,12" Visibility="Collapsed" Opacity="0"
                                ToolTip="Scroll to the newest reply and keep following it" Click="ChatJump_Click" />
                    </Grid>
                    <Border x:Name="CodeComposer" Grid.Row="1" Style="{StaticResource ChatBox}" Margin="20,4,20,16">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <!-- Attached files, photos and folders (MainWindow.Attachments.cs), sent with the next message -->
                            <StackPanel>
                                <!-- Messages typed while the models work (MainWindow.Queue.cs), sent in order when the reply finishes -->
                                <StackPanel x:Name="CodeQueueList" Margin="2,0,2,6" Visibility="Collapsed" />
                                <WrapPanel x:Name="CodeAttachList" Margin="2,0,2,6" Visibility="Collapsed" />
                            </StackPanel>
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <Button x:Name="CodePlus" Style="{StaticResource GhostButton}" Content="+" FontSize="20" Width="34" Height="34" Padding="0,0,0,2"
                                        VerticalAlignment="Bottom" Click="Plus_Click" ToolTip="Add files, photos or a folder" AutomationProperties.Name="Add files or a folder" />
                                <TextBox x:Name="CodeInput" Grid.Column="1" Style="{StaticResource ChatInput}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="34" MaxHeight="170"
                                         VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Center" Margin="4,0,8,0"
                                         PreviewKeyDown="ChatInput_PreviewKeyDown" TextChanged="ChatInput_TextChanged" AutomationProperties.Name="Message" />
                                <TextBlock x:Name="CodeBusyText" Grid.Column="2" Foreground="{DynamicResource Muted}" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"
                                           MaxWidth="280" TextTrimming="CharacterEllipsis" Visibility="Collapsed" />
                                <Button x:Name="CodeStop" Grid.Column="3" Style="{StaticResource GhostButton}" Width="34" Height="34" Padding="0"
                                        VerticalAlignment="Bottom" Visibility="Collapsed" Click="StopWork_Click" ToolTip="Stop (Ctrl+Shift+X)" AutomationProperties.Name="Stop">
                                    <Rectangle Width="11" Height="11" RadiusX="2" RadiusY="2" Fill="{DynamicResource TextPrimary}" />
                                </Button>
                                <!-- Send: an enter arrow, shown once there is text; while the models work it queues the message, beside the stop square. -->
                                <Button x:Name="CodeSend" Grid.Column="4" Style="{StaticResource GhostButton}" Width="34" Height="34" Padding="0" Visibility="Collapsed"
                                        VerticalAlignment="Bottom" Click="ChatSend_Click" ToolTip="Send (Enter)" AutomationProperties.Name="Send">
                                    <TextBlock Text="&#xE751;" Style="{StaticResource RailGlyph}" FontSize="15" Foreground="{DynamicResource TextPrimary}" />
                                </Button>
                            </Grid>
                            <DockPanel Grid.Row="2" Margin="4,6,2,0">
                                <Button x:Name="CodeTargetChip" DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Background="{DynamicResource Hover}"
                                        Foreground="{DynamicResource TextPrimary}" FontSize="11" Padding="11,3" Cursor="Hand" Click="ChatTarget_Click" ToolTip="The lead (the Planner) answers and hands parts to your other workers; Options opens its model settings" />
                                <Button x:Name="CodeEffortChip" DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Background="{DynamicResource Hover}" Margin="0,0,6,0"
                                        Foreground="{DynamicResource TextPrimary}" FontSize="11" Padding="11,3" Click="Effort_Click" ToolTipService.ShowOnDisabled="True" />
                                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="-4,0,8,0">
                                    <ToggleButton x:Name="CodeSearchToggle" Style="{StaticResource ChipToggle}" Tag="search" Click="ExtraToggle_Click" AutomationProperties.Name="Search"
                                                  ToolTip="Let the worker search the web (DuckDuckGo) and read the pages it finds">
                                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE774;" Style="{StaticResource RailGlyph}" FontSize="11" Margin="0,0,5,0" /><TextBlock Text="Search" /></StackPanel>
                                    </ToggleButton>
                                    <ToggleButton x:Name="CodeToolsToggle" Style="{StaticResource ChipToggle}" Tag="tools" Click="ExtraToggle_Click" AutomationProperties.Name="Tools"
                                                  ToolTip="Give the worker utilities: calculator, current date and time, and reading a web page by URL">
                                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE943;" Style="{StaticResource RailGlyph}" FontSize="11" Margin="0,0,5,0" /><TextBlock Text="Tools" /></StackPanel>
                                    </ToggleButton>
                                    <ToggleButton x:Name="CodeSkillsButton" Style="{StaticResource ChipToggle}" Click="Skills_Click" AutomationProperties.Name="Skills"
                                                  ToolTip="Skills the worker may load: folders with a SKILL.md in the skills folder">
                                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8F1;" Style="{StaticResource RailGlyph}" FontSize="11" Margin="0,0,5,0" /><TextBlock Text="Skills  ▾" /></StackPanel>
                                    </ToggleButton>
                                </StackPanel>
                                <TextBlock x:Name="CodeHint" Text="Enter to send  ·  Shift+Enter for a new line" Foreground="{DynamicResource Muted}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                        </Grid>
                    </Border>
                </Grid>

            <!-- Run output: model output + execution log -->
            <Grid x:Name="WorkArea" Grid.Row="1" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DockPanel Margin="20,16,20,8" LastChildFill="False">
                    <TextBlock Text="MODEL OUTPUT" Style="{StaticResource SectionHeader}" VerticalAlignment="Center" />
                    <!-- Run clocks (MainWindow.ShowClocks): the current/last task and the current/last worker turn. -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0" TextBlock.FontSize="11">
                        <TextBlock Text="TASK TIME" Style="{StaticResource SectionHeader}" FontSize="10" VerticalAlignment="Center" />
                        <TextBlock x:Name="TaskTimeText" Text="—" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" MinWidth="34"
                                   Foreground="{DynamicResource TextPrimary}" Margin="6,0,14,0" VerticalAlignment="Center" />
                        <TextBlock Text="TURN TIME" Style="{StaticResource SectionHeader}" FontSize="10" VerticalAlignment="Center" />
                        <TextBlock x:Name="TurnTimeText" Text="—" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" MinWidth="34"
                                   Foreground="{DynamicResource TextPrimary}" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Copy output" Padding="10,4" FontSize="11" Click="CopyOutput_Click" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Clear" Padding="10,4" FontSize="11" Click="ClearOutput_Click" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Collapse all" Padding="10,4" FontSize="11" Click="CollapseAll_Click"
                            ToolTip="Collapse every output section (Ctrl+Shift+E)" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Expand all" Padding="10,4" FontSize="11" Click="ExpandAll_Click"
                            ToolTip="Expand every output section (Ctrl+E)" />
                </DockPanel>
                <Grid Grid.Row="1">
                    <ScrollViewer x:Name="OutputScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,2,0" ScrollChanged="OutputScroll_ScrollChanged">
                        <StackPanel x:Name="OutputPanel" Margin="20,0,12,12" />
                    </ScrollViewer>
                    <!-- Emblem: an accent halo that breathes slowly (EmptyState_IsVisibleChanged) behind a lit disc. -->
                    <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                                IsVisibleChanged="EmptyState_IsVisibleChanged">
                        <Grid Width="160" Height="160" HorizontalAlignment="Center">
                            <Ellipse x:Name="EmblemGlow" Fill="{DynamicResource AccentGlow}" Opacity="0.6" RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform><ScaleTransform x:Name="EmblemScale" /></Ellipse.RenderTransform>
                            </Ellipse>
                            <Ellipse Width="116" Height="116" Stroke="{DynamicResource Border}" StrokeThickness="1" />
                            <Ellipse Width="84" Height="84" Fill="{DynamicResource Card}" Stroke="{DynamicResource AccentEdge}" StrokeThickness="1.5" />
                            <TextBlock Text="◈" FontSize="38" Foreground="{DynamicResource AccentLight}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,3" />
                        </Grid>
                        <TextBlock Text="No output yet" FontFamily="{StaticResource DisplayFont}" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,6,0,6" />
                        <TextBlock Text="Thinking, tool calls and responses appear here as the agents work." Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" />
                    </StackPanel>
                    <!-- Shown (Reveal) when output arrives while the user has scrolled up; returns to following. -->
                    <Button x:Name="JumpPill" Style="{StaticResource PrimaryButton}" Content="Jump to latest  ↓" FontSize="12" Padding="16,7"
                            HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,16" Visibility="Collapsed" Opacity="0"
                            ToolTip="Scroll to the newest output and keep following it" Click="JumpToLatest_Click" />
                </Grid>

                <!-- Execution log: anchored to the bottom of this column, expands upward -->
                <Border Grid.Row="2" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Background="{DynamicResource Panel}">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top">
                            <ToggleButton x:Name="LogToggle" Style="{StaticResource BlockHeaderToggle}" Click="LogToggle_Click" Margin="8,0,0,0" HorizontalAlignment="Left"
                                          ToolTip="Show or hide the execution log (Ctrl+L)">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="EXECUTION LOG" Style="{StaticResource SectionHeader}" VerticalAlignment="Center" />
                                    <TextBlock x:Name="LogCount" Text="0" Foreground="{DynamicResource Muted}" FontFamily="Consolas" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </ToggleButton>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,14,0">
                                <Button Style="{StaticResource GhostButton}" Content="Open logs" Padding="10,4" FontSize="11" Click="OpenLogs_Click"
                                        ToolTip="The saved execution logs, one file per day (kept 14 days)" />
                                <Button x:Name="CopyLogButton" Style="{StaticResource GhostButton}" Content="Copy full log" Padding="10,4" FontSize="11" Click="CopyLog_Click" />
                            </StackPanel>
                        </Grid>
                        <TextBox x:Name="LogBox" Height="230" IsReadOnly="True" TextWrapping="NoWrap" FontFamily="Consolas" FontSize="12" Visibility="Collapsed"
                                 Margin="14,0,14,12" Background="{DynamicResource AppBackground}"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
                    </DockPanel>
                </Border>
            </Grid>
            </Grid>

            <GridSplitter x:Name="SplitterBar" Grid.Column="2" Width="6" HorizontalAlignment="Stretch" ResizeDirection="Columns"
                          Background="{DynamicResource Hover}" ShowsPreview="False" DragCompleted="Splitter_DragCompleted" />

            <!-- Right column: model details -->
            <Border x:Name="DetailsPanel" Grid.Column="3" Background="{DynamicResource Panel}">
              <DockPanel>
                <!-- Context: the open conversation's context usage, pinned to the column's bottom (MainWindow.Context.cs) -->
                <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="13,6,17,10">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock x:Name="ContextSummary" DockPanel.Dock="Right" Foreground="{DynamicResource Muted}" FontSize="11" VerticalAlignment="Center" />
                            <ToggleButton x:Name="ContextSectionToggle" Style="{StaticResource BlockHeaderToggle}" HorizontalAlignment="Left" Click="ContextSection_Click"
                                          ToolTip="Show or hide the context breakdown" AutomationProperties.Name="Context">
                                <TextBlock Text="CONTEXT" Style="{StaticResource SectionHeader}" VerticalAlignment="Center" />
                            </ToggleButton>
                        </DockPanel>
                        <ContentControl x:Name="ContextSectionBody" Margin="4,8,0,0" Visibility="Collapsed" />
                    </StackPanel>
                </Border>
                <DockPanel DockPanel.Dock="Top" Margin="17,17,17,10">
                    <Button x:Name="RailCollapseButton" DockPanel.Dock="Left" Style="{StaticResource GhostButton}" Width="26" Height="26" Padding="0" Margin="-6,0,4,0"
                            Click="WorkerRailToggle_Click" ToolTip="Collapse to the worker rail" AutomationProperties.Name="Collapse worker details">
                        <TextBlock Text="&#xE76C;" Style="{StaticResource RailGlyph}" FontSize="12" />
                    </Button>
                    <TextBlock DockPanel.Dock="Left" Text="WORKER DETAILS" Style="{StaticResource SectionHeader}" VerticalAlignment="Center" />
                    <Button x:Name="PresetsButton" Style="{StaticResource GhostButton}" Content="Presets  &#x25BE;" FontSize="11" Padding="9,3"
                            Margin="10,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Click="Presets_Click"
                            ToolTip="Save, apply or delete named presets: each saves the workers in the tabs and all their settings" />
                </DockPanel>
                <!-- Worker tabs (MainWindow.WorkerTabs.cs): one per shown worker, the selected one's settings below -->
                <DockPanel DockPanel.Dock="Top" Margin="10,0,10,10">
                    <Button x:Name="AddWorkerButton" DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="+" FontSize="16" Width="28" Padding="0,0,0,2"
                            Margin="4,0,0,8" Click="AddWorker_Click" ToolTip="Add the Implementer, the Reviewer or a custom worker" AutomationProperties.Name="Add worker" />
                    <ScrollViewer x:Name="WorkerTabsScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                  SizeChanged="WorkerTabs_SizeChanged" PreviewMouseWheel="WorkerTabs_MouseWheel">
                        <ItemsControl x:Name="WorkerTabs" ItemTemplate="{StaticResource WorkerTabTemplate}" Margin="0,0,0,8">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding Hidden}" Value="True" /><Condition Binding="{Binding IsSelected}" Value="False" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
                <Border x:Name="WorkerSettingsHost" Margin="17,0,4,0" />
              </DockPanel>
            </Border>
            <!-- Browser (MainWindow.Browser.cs): shown in the right column in place of the worker details while open -->
            <Border x:Name="BrowserPanel" Grid.Column="3" Background="{DynamicResource Panel}" Visibility="Collapsed">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="17,17,17,8">
                        <Button DockPanel.Dock="Left" Style="{StaticResource GhostButton}" Width="26" Height="26" Padding="0" Margin="-6,0,4,0"
                                Click="BrowserClose_Click" ToolTip="Close the browser (back to the worker details)" AutomationProperties.Name="Close browser">
                            <TextBlock Text="&#xE76C;" Style="{StaticResource RailGlyph}" FontSize="12" />
                        </Button>
                        <TextBlock DockPanel.Dock="Left" Text="BROWSER" Style="{StaticResource SectionHeader}" VerticalAlignment="Center" />
                        <ToggleButton x:Name="BrowserFollowToggle" DockPanel.Dock="Right" Style="{StaticResource ChipToggle}" Click="BrowserFollow_Click" VerticalAlignment="Center"
                                      ToolTip="Open each page the model reads (fetch_page) here as it reads it" AutomationProperties.Name="Follow the model">
                            <TextBlock Text="Follow the model" />
                        </ToggleButton>
                        <Border />
                    </DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="10,0,10,8">
                        <Button x:Name="BrowserBack" Style="{StaticResource GhostButton}" Width="28" Height="28" Padding="0" Click="BrowserBack_Click" ToolTip="Back" AutomationProperties.Name="Back">
                            <TextBlock Text="&#xE72B;" Style="{StaticResource RailGlyph}" FontSize="12" />
                        </Button>
                        <Button x:Name="BrowserForward" Style="{StaticResource GhostButton}" Width="28" Height="28" Padding="0" Click="BrowserForward_Click" ToolTip="Forward" AutomationProperties.Name="Forward">
                            <TextBlock Text="&#xE72A;" Style="{StaticResource RailGlyph}" FontSize="12" />
                        </Button>
                        <Button Style="{StaticResource GhostButton}" Width="28" Height="28" Padding="0" Click="BrowserReload_Click" ToolTip="Reload" AutomationProperties.Name="Reload">
                            <TextBlock Text="&#xE72C;" Style="{StaticResource RailGlyph}" FontSize="12" />
                        </Button>
                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Width="28" Height="28" Padding="0" Click="BrowserExternal_Click"
                                ToolTip="Open this page in your default browser" AutomationProperties.Name="Open in default browser">
                            <TextBlock Text="&#xE8A7;" Style="{StaticResource RailGlyph}" FontSize="12" />
                        </Button>
                        <TextBox x:Name="BrowserAddress" Height="28" Margin="6,0,4,0" Padding="10,0" VerticalContentAlignment="Center" KeyDown="BrowserAddress_KeyDown"
                                 AutomationProperties.Name="Address" ToolTip="A web address, or words to search for" />
                    </DockPanel>
                    <Grid>
                        <ContentControl x:Name="BrowserHost" />
                        <TextBlock x:Name="BrowserMessage" Margin="20" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Visibility="Collapsed" />
                    </Grid>
                </DockPanel>
            </Border>
            <!-- Collapsed worker details: one activity dot per visible worker; hovering a dot shows its card (MainWindow.WorkerRail.cs) -->
            <Border x:Name="WorkerRail" Grid.Column="3" Width="44" HorizontalAlignment="Left" Panel.ZIndex="1" Background="{DynamicResource Panel}" Visibility="Collapsed">
                <StackPanel Margin="0,12,0,0">
                    <Button x:Name="RailExpandButton" Style="{StaticResource GhostButton}" Width="28" Height="28" Padding="0" Margin="0,0,0,10"
                            Click="WorkerRailToggle_Click" ToolTip="Show worker details" AutomationProperties.Name="Show worker details">
                        <TextBlock Text="&#xE76B;" Style="{StaticResource RailGlyph}" FontSize="12" />
                    </Button>
                    <ItemsControl x:Name="RailDots">
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Hidden}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="32" Background="Transparent" MouseEnter="RailDot_MouseEnter" MouseLeave="RailHover_MouseLeave"
                                      AutomationProperties.Name="{Binding Title}">
                                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource ActivityDot}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button x:Name="RailAddWorker" Style="{StaticResource GhostButton}" Content="+" FontSize="16" Width="28" Height="28" Padding="0,0,0,2" Margin="0,6,0,0"
                            Click="AddWorker_Click" IsEnabled="{Binding IsEnabled, ElementName=AddWorkerButton}" ToolTip="Add a worker" AutomationProperties.Name="Add worker" />
                    <Popup x:Name="RailPopup" Placement="Left" AllowsTransparency="True" PopupAnimation="Fade">
                        <Border Width="320" Padding="0,0,6,0" Background="Transparent" MouseEnter="RailPopup_MouseEnter" MouseLeave="RailHover_MouseLeave">
                            <ContentControl x:Name="RailCard" ContentTemplate="{StaticResource RailCardTemplate}" />
                        </Border>
                    </Popup>
                </StackPanel>
            </Border>
            <!-- Chat: replaces the work area (the splitter and worker cards stay) -->
            <Grid x:Name="ChatView" Grid.Column="1" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DockPanel Margin="20,16,20,8" LastChildFill="False">
                    <TextBlock Text="CHAT" Style="{StaticResource SectionHeader}" VerticalAlignment="Center" />
                    <Button x:Name="ChatContextRing" DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Padding="0" Margin="0,0,12,0" VerticalAlignment="Center"
                            Click="ContextRing_Click" AutomationProperties.Name="Context usage" />
                </DockPanel>
                <Grid Grid.Row="1">
                    <ScrollViewer x:Name="ChatScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,2,0" ScrollChanged="ChatScroll_ScrollChanged"
                                  SizeChanged="ConversationScroll_SizeChanged">
                        <StackPanel x:Name="ChatPanel" Margin="20,0,12,12" />
                    </ScrollViewer>
                    <ContentControl x:Name="ChatContextPin" HorizontalAlignment="Right" VerticalAlignment="Top" Width="280" Margin="0,0,20,0" Visibility="Collapsed" />
                    <StackPanel x:Name="ChatEmpty" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock Text="Start a conversation" FontFamily="{StaticResource DisplayFont}" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,6" />
                        <TextBlock Text="Ask anything; the model can hand parts off to other workers when needed." Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" />
                    </StackPanel>
                    <Button x:Name="ChatJumpPill" Style="{StaticResource PrimaryButton}" Content="Jump to latest  ↓" FontSize="12" Padding="16,7"
                            HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,12" Visibility="Collapsed" Opacity="0"
                            ToolTip="Scroll to the newest reply and keep following it" Click="ChatJump_Click" />
                </Grid>
                <Border x:Name="ChatComposer" Grid.Row="2" Style="{StaticResource ChatBox}" Margin="20,4,20,16">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <!-- Attached files, photos and folders (MainWindow.Attachments.cs), sent with the next message -->
                        <StackPanel>
                            <!-- Messages typed while the models work (MainWindow.Queue.cs), sent in order when the reply finishes -->
                            <StackPanel x:Name="ChatQueueList" Margin="2,0,2,6" Visibility="Collapsed" />
                            <WrapPanel x:Name="ChatAttachList" Margin="2,0,2,6" Visibility="Collapsed" />
                        </StackPanel>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Button x:Name="ChatPlus" Style="{StaticResource GhostButton}" Content="+" FontSize="20" Width="34" Height="34" Padding="0,0,0,2"
                                    VerticalAlignment="Bottom" Click="Plus_Click" ToolTip="Add files, photos or a folder" AutomationProperties.Name="Add files or a folder" />
                            <TextBox x:Name="ChatInput" Grid.Column="1" Style="{StaticResource ChatInput}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="34" MaxHeight="170"
                                     VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Center" Margin="4,0,8,0"
                                     PreviewKeyDown="ChatInput_PreviewKeyDown" TextChanged="ChatInput_TextChanged" AutomationProperties.Name="Message" />
                            <TextBlock x:Name="ChatBusyText" Grid.Column="2" Foreground="{DynamicResource Muted}" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"
                                       MaxWidth="280" TextTrimming="CharacterEllipsis" Visibility="Collapsed" />
                            <Button x:Name="ChatStop" Grid.Column="3" Style="{StaticResource GhostButton}" Width="34" Height="34" Padding="0"
                                    VerticalAlignment="Bottom" Visibility="Collapsed" Click="StopWork_Click" ToolTip="Stop (Ctrl+Shift+X)" AutomationProperties.Name="Stop">
                                <Rectangle Width="11" Height="11" RadiusX="2" RadiusY="2" Fill="{DynamicResource TextPrimary}" />
                            </Button>
                            <!-- Send: an enter arrow, shown once there is text; while the models work it queues the message, beside the stop square. -->
                            <Button x:Name="ChatSend" Grid.Column="4" Style="{StaticResource GhostButton}" Width="34" Height="34" Padding="0" Visibility="Collapsed"
                                    VerticalAlignment="Bottom" Click="ChatSend_Click" ToolTip="Send (Enter)" AutomationProperties.Name="Send">
                                <TextBlock Text="&#xE751;" Style="{StaticResource RailGlyph}" FontSize="15" Foreground="{DynamicResource TextPrimary}" />
                            </Button>
                        </Grid>
                        <DockPanel Grid.Row="2" Margin="4,6,2,0">
                            <Button x:Name="ChatTargetChip" DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Background="{DynamicResource Hover}"
                                    Foreground="{DynamicResource TextPrimary}" FontSize="11" Padding="11,3" Cursor="Hand" Click="ChatTarget_Click" ToolTip="Choose the worker to message, or open model Options" />
                            <Button x:Name="ChatEffortChip" DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Background="{DynamicResource Hover}" Margin="0,0,6,0"
                                    Foreground="{DynamicResource TextPrimary}" FontSize="11" Padding="11,3" Click="Effort_Click" ToolTipService.ShowOnDisabled="True" />
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="-4,0,8,0">
                                <ToggleButton x:Name="ChatSearchToggle" Style="{StaticResource ChipToggle}" Tag="search" Click="ExtraToggle_Click" AutomationProperties.Name="Search"
                                              ToolTip="Let the worker search the web (DuckDuckGo) and read the pages it finds">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE774;" Style="{StaticResource RailGlyph}" FontSize="11" Margin="0,0,5,0" /><TextBlock Text="Search" /></StackPanel>
                                </ToggleButton>
                                <ToggleButton x:Name="ChatToolsToggle" Style="{StaticResource ChipToggle}" Tag="tools" Click="ExtraToggle_Click" AutomationProperties.Name="Tools"
                                              ToolTip="Give the worker utilities: calculator, current date and time, and reading a web page by URL">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE943;" Style="{StaticResource RailGlyph}" FontSize="11" Margin="0,0,5,0" /><TextBlock Text="Tools" /></StackPanel>
                                </ToggleButton>
                                <ToggleButton x:Name="ChatSkillsButton" Style="{StaticResource ChipToggle}" Click="Skills_Click" AutomationProperties.Name="Skills"
                                              ToolTip="Skills the worker may load: folders with a SKILL.md in the skills folder">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8F1;" Style="{StaticResource RailGlyph}" FontSize="11" Margin="0,0,5,0" /><TextBlock Text="Skills  ▾" /></StackPanel>
                                </ToggleButton>
                            </StackPanel>
                            <TextBlock x:Name="ChatHint" Text="Enter to send  ·  Shift+Enter for a new line" Foreground="{DynamicResource Muted}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                    </Grid>
                </Border>
            </Grid>
            <!-- Settings: shown in their own window (OpenSettings), which borrows SettingsContent from this hidden holder while open. -->
            <Border x:Name="SettingsHolder" Grid.Column="1" Visibility="Collapsed">
            <ScrollViewer x:Name="SettingsContent" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="SETTINGS" Style="{StaticResource SectionHeader}" />
                    <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="48" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <StackPanel>
                    <TextBlock Text="Theme" FontFamily="{StaticResource DisplayFont}" FontSize="20" FontWeight="SemiBold" Margin="0,16,0,0" />
                    <RadioButton x:Name="ThemeFlatRadio" GroupName="Theme" Content="Flat — modern, rounded, borderless dark theme" Margin="0,14,0,8" Checked="Theme_Checked" />
                    <RadioButton x:Name="ThemeGoldRadio" GroupName="Theme" Content="Track Gold — the original dark gold theme" Margin="0,0,0,8" Checked="Theme_Checked" />
                    <RadioButton x:Name="ThemeGlassRadio" GroupName="Theme" Content="Liquid Glass — translucent blue modern theme" Margin="0,0,0,8" Checked="Theme_Checked" />
                    <RadioButton x:Name="ThemeOledRadio" GroupName="Theme" Content="OLED — pure black, flat, purple accents" Margin="0,0,0,8" Checked="Theme_Checked" />
                    <RadioButton x:Name="ThemeGraphiteRadio" GroupName="Theme" Content="Graphite — flat dark gray with light gray accents" Margin="0,0,0,8" Checked="Theme_Checked" />
                    <RadioButton x:Name="ThemeParchmentRadio" GroupName="Theme" Content="Parchment — light warm paper with clay accents" Margin="0,0,0,8" Checked="Theme_Checked" />
                    <RadioButton x:Name="ThemeParchmentDarkRadio" GroupName="Theme" Content="Dark Parchment — warm dark gray with clay accents (default)" Checked="Theme_Checked" />
                    <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                        <TextBlock Text="Accent" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <Button x:Name="AccentButton" Padding="11,6" HorizontalAlignment="Left" VerticalAlignment="Center" ToolTip="Accent colour for this theme" Click="Accent_Click">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="10" Height="10" Fill="{DynamicResource Accent}" Margin="0,0,7,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="AccentLabel" Text="Accent" />
                        </StackPanel>
                        <Button.ContextMenu><ContextMenu x:Name="AccentMenu" Opened="AccentMenu_Opened" /></Button.ContextMenu>
                    </Button>
                    </StackPanel>
                    <TextBlock Text="Each theme remembers its own accent colour." Foreground="{DynamicResource Muted}" Margin="0,8,0,0" />
                    <TextBlock Text="Conversation" FontFamily="{StaticResource DisplayFont}" FontSize="20" FontWeight="SemiBold" Margin="0,32,0,0" />
                    <DockPanel Margin="0,14,0,0">
                        <ToggleButton x:Name="CenterChatToggle" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" IsChecked="True" Click="CenterChat_Click" VerticalAlignment="Center"
                                      AutomationProperties.Name="Center the conversation" />
                        <TextBlock Text="Center the conversation" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock Text="On: messages and the message box keep a readable width in the middle of the column. Off: they fill the column."
                               TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,8,0,0" />
                    <DockPanel Margin="0,14,0,0">
                        <ToggleButton x:Name="ContextPercentToggle" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" Click="ContextPercent_Click" VerticalAlignment="Center"
                                      AutomationProperties.Name="Show the context percentage" />
                        <TextBlock Text="Show the context percentage" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock Text="The Context card shows how full the context is as a number (e.g. 34%) beside its ring."
                               TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,8,0,0" />
                    <TextBlock Text="Models" FontFamily="{StaticResource DisplayFont}" FontSize="20" FontWeight="SemiBold" Margin="0,32,0,0" />
                    <DockPanel Margin="0,14,0,0">
                        <ToggleButton x:Name="ChatKeepToggle" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" IsChecked="True" Click="ChatKeep_Click" VerticalAlignment="Center"
                                      AutomationProperties.Name="Keep models loaded" />
                        <TextBlock Text="Keep models loaded" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock Text="On: models stay loaded between chat messages, so replies start faster (they are unloaded when the app closes). Off: each reply unloads the models it loaded, freeing GPU memory."
                               TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,8,0,0" />
                    <TextBlock Text="Usage stats" FontFamily="{StaticResource DisplayFont}" FontSize="20" FontWeight="SemiBold" Margin="0,32,0,0" />
                    <DockPanel Margin="0,14,0,0">
                        <Button x:Name="ResetStatsButton" Content="Reset usage stats" Padding="11,6" VerticalAlignment="Center" Click="ResetStats_Click" />
                        <TextBlock x:Name="StatsSummary" VerticalAlignment="Center" Margin="12,0,0,0" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Muted}" />
                    </DockPanel>
                    <TextBlock Text="Your profile's lifetime tokens, peak day, longest task and streaks. They are kept when chats are deleted, until you reset them here."
                               TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,8,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                    <TextBlock Text="Model runtime" FontFamily="{StaticResource DisplayFont}" FontSize="20" FontWeight="SemiBold" Margin="0,16,0,0" />
                    <RadioButton x:Name="RuntimeUnslothRadio" GroupName="Runtime" Content="Unsloth Studio (API)" Margin="0,14,0,8" Checked="Runtime_Checked" />
                    <RadioButton x:Name="RuntimeLlamaRadio" GroupName="Runtime" Content="Local — llama.cpp (llama-server)" Checked="Runtime_Checked" />
                    <DockPanel Margin="0,14,0,0">
                        <Button x:Name="LlamaDownloadButton" Content="Download llama-server" Padding="11,6" VerticalAlignment="Center" Click="LlamaDownload_Click" />
                        <TextBlock x:Name="LlamaStatus" Text="llama-server not installed" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap" />
                    </DockPanel>
                    <DockPanel Margin="0,10,0,0">
                        <Button Content="Models folder…" Padding="11,6" VerticalAlignment="Center" Click="ModelsFolder_Click" />
                        <Button x:Name="ModelsFolderClear" DockPanel.Dock="Right" Content="Clear" Padding="11,6" VerticalAlignment="Center" Margin="10,0,0,0" Click="ModelsFolderClear_Click" />
                        <TextBlock x:Name="ModelsFolderText" VerticalAlignment="Center" Margin="12,0,0,0" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                    <TextBlock Text="GGUF files are found in the Hugging Face cache (where Unsloth downloads them) and in this folder." TextWrapping="Wrap"
                               Foreground="{DynamicResource Muted}" Margin="0,8,0,0" />
                    <!-- Code engine (MainWindow.Pi.cs): who runs a Code turn's agent loop -->
                    <TextBlock Text="Code engine" FontFamily="{StaticResource DisplayFont}" FontSize="20" FontWeight="SemiBold" Margin="0,32,0,0" />
                    <RadioButton x:Name="EngineBuiltinRadio" GroupName="CodeEngine" Content="Built-in" Margin="0,14,0,8" Checked="CodeEngine_Checked" />
                    <RadioButton x:Name="EnginePiRadio" GroupName="CodeEngine" Content="Pi (pi.dev agent harness)" Checked="CodeEngine_Checked" />
                    <DockPanel Margin="0,14,0,0">
                        <Button x:Name="PiInstallButton" Content="Install Pi" Padding="11,6" VerticalAlignment="Center" Click="PiInstall_Click" />
                        <TextBlock x:Name="PiStatus" Text="Pi not installed" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap" />
                    </DockPanel>
                    <TextBlock Text="Pi runs the Code lead's agent loop on the same model, with its own edit tool, sessions and compaction; the folder grants, your workers, skills and Start project stay the same. Needs Node.js 22.19 or newer."
                               TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,8,0,0" />
                    <TextBlock Text="Unsloth API key" FontFamily="{StaticResource DisplayFont}" FontSize="20" FontWeight="SemiBold" Margin="0,32,0,0" />
                    <PasswordBox x:Name="ApiKeyBox" Margin="0,14,0,0" />
                    <TextBlock x:Name="ApiKeyHint" Text="Enter the key, or place a one-line api_key.txt beside the EXE." TextWrapping="Wrap"
                               Foreground="{DynamicResource Muted}" Margin="0,8,0,0" />
                    </StackPanel>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
            </Border>
        </Grid>


        <!-- Toasts (MainWindow.Toast): newest at the bottom, just above the status bar -->
        <StackPanel x:Name="ToastStack" Grid.Row="2" Grid.Column="1" IsHitTestVisible="False" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,20,16" />

        <!-- Status bar -->
        <Border Grid.Row="3" Grid.Column="1" Background="{DynamicResource TitleBackground}" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0">
            <DockPanel Margin="14,0" LastChildFill="False">
                <TextBlock x:Name="FooterRight" DockPanel.Dock="Right" Foreground="{DynamicResource Muted}" FontFamily="Consolas" FontSize="11" VerticalAlignment="Center" />
                <TextBlock x:Name="FooterLeft" Foreground="{DynamicResource Muted}" FontFamily="Consolas" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
