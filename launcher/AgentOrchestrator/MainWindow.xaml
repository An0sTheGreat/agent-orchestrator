<Window x:Class="AgentOrchestrator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Agent Orchestrator" Width="1400" Height="860" MinWidth="1040" MinHeight="620"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource AppBackground}" Foreground="{DynamicResource TextPrimary}" FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Ideal">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" CornerRadius="0"
                            GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <SolidColorBrush x:Key="AppBackground" Color="#101116" />
        <SolidColorBrush x:Key="TextPrimary" Color="#ECEEF5" />
        <SolidColorBrush x:Key="TitleBackground" Color="#101116" />
        <SolidColorBrush x:Key="Panel" Color="#16171D" />
        <SolidColorBrush x:Key="Card" Color="#1E2028" />
        <SolidColorBrush x:Key="Hover" Color="#292C36" />
        <SolidColorBrush x:Key="Border" Color="#242630" />
        <SolidColorBrush x:Key="Muted" Color="#8E93A6" />
        <SolidColorBrush x:Key="Accent" Color="#4C8DFF" />
        <SolidColorBrush x:Key="AccentLight" Color="#86B3FF" />
        <SolidColorBrush x:Key="ControlBorder" Color="#00000000" />
        <SolidColorBrush x:Key="OnAccent" Color="#FFFFFF" />
        <CornerRadius x:Key="ControlRadius">17</CornerRadius>
        <CornerRadius x:Key="CardRadius">14</CornerRadius>
        <CornerRadius x:Key="PanelRadius">14</CornerRadius>
        <CornerRadius x:Key="SmallRadius">10</CornerRadius>

        <Style TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="Background" Value="{DynamicResource Card}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource ControlRadius}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource Hover}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource Accent}" />
            <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource ControlRadius}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource AccentLight}" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource AccentLight}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
        </Style>
        <Style x:Key="TitleButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="46" /><Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" /><Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource TitleButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CloseBorder" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CloseBorder" Property="Background" Value="#C42B1C" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas" /><Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="11" /><Setter Property="Foreground" Value="{DynamicResource Muted}" />
        </Style>
        <Style x:Key="SubHeader" TargetType="TextBlock" BasedOn="{StaticResource SectionHeader}">
            <Setter Property="FontSize" Value="10" /><Setter Property="Margin" Value="8,16,0,6" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" /><Setter Property="Background" Value="{DynamicResource Card}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}" /><Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,8" /><Setter Property="CaretBrush" Value="{DynamicResource AccentLight}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Field" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource ControlRadius}"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Hidden" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Field" Property="BorderBrush" Value="{DynamicResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Field" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" /><Setter Property="Background" Value="{DynamicResource Card}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}" /><Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,8" /><Setter Property="CaretBrush" Value="{DynamicResource AccentLight}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="Field" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource ControlRadius}"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Hidden" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Field" Property="BorderBrush" Value="{DynamicResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Field" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <BulletDecorator Background="Transparent">
                            <BulletDecorator.Bullet>
                                <Grid Width="14" Height="14" Margin="0,0,7,0">
                                    <Ellipse x:Name="Ring" Fill="{DynamicResource Card}" Stroke="{DynamicResource Muted}" StrokeThickness="1.5" />
                                    <Ellipse x:Name="Dot" Width="7" Height="7" Fill="{DynamicResource AccentLight}" Visibility="Collapsed" />
                                </Grid>
                            </BulletDecorator.Bullet>
                            <ContentPresenter VerticalAlignment="Center" Margin="4,0,0,0" />
                        </BulletDecorator>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource AccentLight}" />
                                <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="White" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ToggleSwitch" TargetType="ToggleButton">
            <Setter Property="Width" Value="42" /><Setter Property="Height" Value="23" /><Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <Border x:Name="Track" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Border}"
                                    BorderThickness="1" CornerRadius="12" />
                            <Ellipse x:Name="Knob" Width="17" Height="17" Fill="{DynamicResource Muted}"
                                     HorizontalAlignment="Left" Margin="3,0,0,0" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource Accent}" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentLight}" />
                                <Setter TargetName="Knob" Property="Fill" Value="White" />
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Knob" Property="Margin" Value="0,0,3,0" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ContextMenu">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="HasDropShadow" Value="False" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{DynamicResource Card}" BorderBrush="{DynamicResource Border}" BorderThickness="1"
                                CornerRadius="{DynamicResource SmallRadius}" Padding="5">
                            <ScrollViewer MaxHeight="460" VerticalScrollBarVisibility="Auto">
                                <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="Padding" Value="8,7" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Row" Background="Transparent" CornerRadius="{DynamicResource SmallRadius}" Padding="{TemplateBinding Padding}" Margin="0,1">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" MinWidth="120" /></Grid.ColumnDefinitions>
                                <TextBlock x:Name="Check" Text="&#x2713;" Foreground="{DynamicResource AccentLight}" FontWeight="Bold"
                                           VerticalAlignment="Center" Visibility="Collapsed" />
                                <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="False" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="Check" Property="Visibility" Value="Visible" /></Trigger>
                            <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource Hover}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NavToggle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="Padding" Value="14,8,10,8" />
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <Border x:Name="Nav" Background="Transparent" CornerRadius="{DynamicResource ControlRadius}" Padding="{TemplateBinding Padding}">
                                <ContentPresenter VerticalAlignment="Center" />
                            </Border>
                            <Border x:Name="Bar" Width="3" Height="16" CornerRadius="2" Background="{DynamicResource Accent}"
                                    HorizontalAlignment="Left" Margin="4,0,0,0" Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Nav" Property="Background" Value="{DynamicResource Hover}" /></Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Nav" Property="Background" Value="{DynamicResource Card}" />
                                <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentLight}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="10" /><Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" /></Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="{DynamicResource Muted}" CornerRadius="3" Margin="2,0" Opacity="0.6" /></ControlTemplate></Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" /></Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Collapsible thinking / tool sections -->
        <Style x:Key="BlockHeaderToggle" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Head" Background="Transparent" Padding="12,8" CornerRadius="{DynamicResource SmallRadius}">
                            <DockPanel>
                                <TextBlock x:Name="Glyph" DockPanel.Dock="Left" Text="&#x25B8;" Width="16" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" />
                                <ContentPresenter VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Head" Property="Background" Value="{DynamicResource Hover}" /></Trigger>
                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="Glyph" Property="Text" Value="&#x25BE;" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="BlockExpander" TargetType="Expander">
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <Border Background="{DynamicResource Card}" CornerRadius="{DynamicResource SmallRadius}">
                            <DockPanel>
                                <ToggleButton DockPanel.Dock="Top" Style="{StaticResource BlockHeaderToggle}"
                                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                    <ContentPresenter ContentSource="Header" />
                                </ToggleButton>
                                <ContentPresenter x:Name="Body" Margin="14,0,14,12" Visibility="Collapsed" />
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True"><Setter TargetName="Body" Property="Visibility" Value="Visible" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <BooleanToVisibilityConverter x:Key="BoolVis" />
        <Style x:Key="Chip" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Hover}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="9,3" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>

        <DataTemplate x:Key="RoleCardTemplate">
            <Border Background="{DynamicResource Card}" CornerRadius="{DynamicResource PanelRadius}" Padding="14,12" Margin="0,0,0,10"
                    BorderThickness="2" AllowDrop="True" DragOver="Card_DragOver" DragLeave="Card_DragLeave" Drop="Card_Drop">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="Transparent" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DropHover}" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource Accent}" /></DataTrigger>
                            <DataTrigger Binding="{Binding IsDragging}" Value="True"><Setter Property="Opacity" Value="0.3" /></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Text="&#x2630;" Foreground="{DynamicResource Muted}" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"
                                   Cursor="SizeAll" ToolTip="Drag to reorder" Background="Transparent" PreviewMouseMove="Handle_MouseMove" />
                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="&#x2715;" Padding="7,2" Margin="4,0,0,0" FontSize="11"
                                ToolTip="Remove this worker" Visibility="{Binding IsCustom, Converter={StaticResource BoolVis}}" Click="RemoveWorker_Click" />
                        <Border DockPanel.Dock="Right" CornerRadius="9" Padding="9,2" VerticalAlignment="Center">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource Hover}" />
                                    <Style.Triggers><DataTrigger Binding="{Binding IsActive}" Value="True"><Setter Property="Background" Value="{DynamicResource Accent}" /></DataTrigger></Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding Status}" FontSize="10" FontFamily="Consolas" FontWeight="Bold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource Muted}" />
                                        <Style.Triggers><DataTrigger Binding="{Binding IsActive}" Value="True"><Setter Property="Foreground" Value="{DynamicResource OnAccent}" /></DataTrigger></Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                        <Grid VerticalAlignment="Center">
                            <TextBlock Text="{Binding Title}" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource SectionHeader}">
                                        <Setter Property="Foreground" Value="{DynamicResource AccentLight}" />
                                        <Style.Triggers><DataTrigger Binding="{Binding IsCustom}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" FontWeight="Bold" FontSize="11" Padding="8,3"
                                     Background="{DynamicResource Hover}" ToolTip="Worker title (editable)" LostFocus="TitleBox_LostFocus" MaxLength="32">
                                <TextBox.Style>
                                    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers><DataTrigger Binding="{Binding IsCustom}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                        </Grid>
                    </DockPanel>

                    <TextBlock Text="MODEL" Style="{StaticResource SectionHeader}" FontSize="9" Margin="0,12,0,0" />
                    <DockPanel Margin="0,3,0,0">
                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Change" Padding="9,3" FontSize="11" Margin="8,0,0,0"
                                IsEnabled="{Binding Editable}" ToolTip="Pick from the models installed in Unsloth" Click="ChangeModel_Click" />
                        <TextBlock Text="{Binding ModelName}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding ModelName}" VerticalAlignment="Center" />
                    </DockPanel>

                    <TextBlock Text="WEIGHTS / QUANTIZATION" Style="{StaticResource SectionHeader}" FontSize="9" Margin="0,10,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Border Style="{StaticResource Chip}"><TextBlock Text="{Binding Weights}" FontSize="12" /></Border>
                        <Border Style="{StaticResource Chip}"><TextBlock Text="{Binding Quant}" FontSize="12" /></Border>
                    </StackPanel>

                    <TextBlock Text="TOKENS / SEC" Style="{StaticResource SectionHeader}" FontSize="9" Margin="0,12,0,0" />
                    <TextBlock Text="{Binding TokensPerSec}" FontSize="18" FontWeight="SemiBold" FontFamily="Consolas" Margin="0,2,0,0" />
                    <TextBlock Text="TURN TOKENS" Style="{StaticResource SectionHeader}" FontSize="9" Margin="0,12,0,0" />
                    <TextBlock Text="{Binding TurnTotal}" FontSize="18" FontWeight="SemiBold" FontFamily="Consolas" Margin="0,2,0,0" />
                    <TextBlock Text="{Binding TurnDetail}" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,2,0,0" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="34" /><RowDefinition Height="62" /><RowDefinition Height="*" /><RowDefinition Height="34" />
        </Grid.RowDefinitions>

        <Grid x:Name="ThemeBackdrop" Grid.RowSpan="4" Visibility="Collapsed" IsHitTestVisible="False" Background="{DynamicResource AppBackground}">
            <Ellipse Width="820" Height="820" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-260,-330,0,0">
                <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#70558CFF" Offset="0" /><GradientStop Color="#00465A9C" Offset="1" /></RadialGradientBrush></Ellipse.Fill>
            </Ellipse>
            <Ellipse Width="900" Height="900" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-350,-410">
                <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#5064D8C4" Offset="0" /><GradientStop Color="#003C6A73" Offset="1" /></RadialGradientBrush></Ellipse.Fill>
            </Ellipse>
        </Grid>

        <!-- Title bar -->
        <Border Grid.Row="0" Background="{DynamicResource TitleBackground}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0">
                    <TextBlock Text="◈" Foreground="{DynamicResource Accent}" FontSize="18" />
                    <TextBlock Text="AGENT ORCHESTRATOR" Foreground="{DynamicResource AccentLight}" FontFamily="Consolas"
                               FontWeight="Bold" FontSize="12" Margin="7,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource TitleButton}" Content="─" Click="Minimize_Click" />
                    <Button x:Name="MaximizeButton" Style="{StaticResource TitleButton}" Content="□" Click="Maximize_Click" />
                    <Button Style="{StaticResource CloseButton}" Content="×" Click="Close_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Header: project control -->
        <Border Grid.Row="1" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
            <Grid Margin="14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="StartButton" Grid.Column="0" Style="{StaticResource PrimaryButton}" Content="Start Task"
                        Padding="22,10" MinWidth="170" VerticalAlignment="Center" Click="Start_Click" />
                <Button x:Name="StopButton" Grid.Column="1" Content="Stop" Margin="8,0,0,0" Padding="18,10" VerticalAlignment="Center"
                        IsEnabled="False" Click="Stop_Click" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                    <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="#667085" Margin="0,0,8,0" />
                    <TextBlock x:Name="StatusText" Text="Ready" Foreground="{DynamicResource Muted}" />
                </StackPanel>
                <Button x:Name="AccentButton" Grid.Column="3" Padding="11,8" VerticalAlignment="Center" ToolTip="Accent colour for this theme" Click="Accent_Click">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="10" Height="10" Fill="{DynamicResource Accent}" Margin="0,0,7,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="AccentLabel" Text="Accent" />
                    </StackPanel>
                    <Button.ContextMenu><ContextMenu x:Name="AccentMenu" Opened="AccentMenu_Opened" /></Button.ContextMenu>
                </Button>
            </Grid>
        </Border>

        <!-- Workspace -->
        <Grid x:Name="WorkspaceView" Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="*" MinWidth="380" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition x:Name="DetailsColumn" Width="340" MinWidth="260" MaxWidth="640" />
            </Grid.ColumnDefinitions>

            <!-- Left-side navigation + project setup -->
            <Border Grid.Column="0" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="12,16,12,16">
                        <TextBlock Text="VIEW" Style="{StaticResource SectionHeader}" Margin="8,0,0,8" />
                        <ToggleButton x:Name="NavWorkspace" Style="{StaticResource NavToggle}" Content="Workspace" IsChecked="True" Click="Nav_Click" Tag="Workspace" />
                        <ToggleButton x:Name="NavOptions" Style="{StaticResource NavToggle}" Content="Options" Click="Nav_Click" Tag="Options" />

                        <TextBlock Text="PROJECT" Style="{StaticResource SubHeader}" />
                        <TextBox x:Name="ProjectPathBox" ToolTip="Target project folder (a new path will be created on initialize)" />
                        <Button Content="Browse…" Margin="0,8,0,0" HorizontalAlignment="Stretch" Click="Browse_Click" />
                        <Border x:Name="InitializationPanel" Visibility="Collapsed" Background="{DynamicResource Card}" CornerRadius="{DynamicResource SmallRadius}" Padding="12" Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock x:Name="InitializationText" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="12" />
                                <Button Content="Initialize Project" Style="{StaticResource PrimaryButton}" Margin="0,10,0,0" Click="InitializeProject_Click" />
                                <Button Content="Use custom PROJECT.md…" Margin="0,6,0,0" Click="ChooseProjectFile_Click" />
                                <Button Content="Use custom config.json…" Margin="0,6,0,0" Click="ChooseConfigFile_Click" />
                                <TextBlock x:Name="CustomFilesText" Text="Using Agent Setup templates." TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>
                        <Button Content="Edit PROJECT.md" Margin="0,8,0,0" Click="EditProject_Click" />

                        <TextBlock Text="RUN" Style="{StaticResource SubHeader}" />
                        <DockPanel Margin="8,0,0,0">
                            <ToggleButton x:Name="OnceToggle" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" IsChecked="True" Click="Once_Click" />
                            <TextBlock Text="Run one reviewed task, then stop" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,10,0" />
                        </DockPanel>

                        <TextBlock Text="UNSLOTH API KEY" Style="{StaticResource SubHeader}" />
                        <PasswordBox x:Name="ApiKeyBox" />
                        <TextBlock x:Name="ApiKeyHint" Text="Enter the key, or place a one-line api_key.txt beside the EXE." TextWrapping="Wrap"
                                   Foreground="{DynamicResource Muted}" FontSize="11" Margin="8,6,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Left column: model output + execution log -->
            <Grid x:Name="WorkArea" Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DockPanel Margin="20,16,20,8" LastChildFill="False">
                    <TextBlock Text="MODEL OUTPUT" Style="{StaticResource SectionHeader}" VerticalAlignment="Center" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Copy output" Padding="10,4" FontSize="11" Click="CopyOutput_Click" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Clear" Padding="10,4" FontSize="11" Click="ClearOutput_Click" />
                </DockPanel>
                <Grid Grid.Row="1">
                    <ScrollViewer x:Name="OutputScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,2,0" ScrollChanged="OutputScroll_ScrollChanged">
                        <StackPanel x:Name="OutputPanel" Margin="20,0,12,12" />
                    </ScrollViewer>
                    <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock Text="◈" FontSize="66" Foreground="{DynamicResource Border}" HorizontalAlignment="Center" />
                        <TextBlock Text="No output yet" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,6" />
                        <TextBlock Text="Thinking, tool calls and responses appear here as the agents work." Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <!-- Execution log: anchored to the bottom of this column, expands upward -->
                <Border Grid.Row="2" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Background="{DynamicResource Panel}">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top">
                            <ToggleButton x:Name="LogToggle" Style="{StaticResource BlockHeaderToggle}" Click="LogToggle_Click" Margin="8,0,0,0" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="EXECUTION LOG" Style="{StaticResource SectionHeader}" VerticalAlignment="Center" />
                                    <TextBlock x:Name="LogCount" Text="0" Foreground="{DynamicResource Muted}" FontFamily="Consolas" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </ToggleButton>
                            <Button x:Name="CopyLogButton" Style="{StaticResource GhostButton}" Content="Copy full log" Padding="10,4" FontSize="11"
                                    HorizontalAlignment="Right" Margin="0,0,14,0" Click="CopyLog_Click" />
                        </Grid>
                        <TextBox x:Name="LogBox" Height="230" IsReadOnly="True" TextWrapping="NoWrap" FontFamily="Consolas" FontSize="12" Visibility="Collapsed"
                                 Margin="14,0,14,12" Background="{DynamicResource AppBackground}"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
                    </DockPanel>
                </Border>
            </Grid>

            <GridSplitter x:Name="SplitterBar" Grid.Column="2" Width="6" HorizontalAlignment="Stretch" ResizeDirection="Columns"
                          Background="{DynamicResource Hover}" ShowsPreview="False" DragCompleted="Splitter_DragCompleted" />

            <!-- Right column: model details -->
            <Border x:Name="DetailsPanel" Grid.Column="3" Background="{DynamicResource Panel}">
                <ScrollViewer x:Name="DetailsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="17">
                        <TextBlock Text="WORKER DETAILS" Style="{StaticResource SectionHeader}" Margin="0,0,0,12" />
                        <ItemsControl x:Name="CardsList" ItemTemplate="{StaticResource RoleCardTemplate}" />
                        <Button x:Name="AddWorkerButton" Content="+  Add worker" Click="AddWorker_Click" ToolTip="Add a worker with a custom title and model" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
            <!-- Options -->
            <ScrollViewer x:Name="OptionsView" Grid.Column="1" Grid.ColumnSpan="3" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="40,28" MaxWidth="760" HorizontalAlignment="Left">
                    <TextBlock Text="OPTIONS" Style="{StaticResource SectionHeader}" />
                    <TextBlock Text="Theme" FontSize="18" FontWeight="SemiBold" Margin="0,16,0,0" />
                    <RadioButton x:Name="ThemeFlatRadio" GroupName="Theme" Content="Flat — modern, rounded, borderless dark theme (default)" Margin="0,14,0,8" Checked="Theme_Checked" />
                    <RadioButton x:Name="ThemeGoldRadio" GroupName="Theme" Content="Track Gold — the original dark gold theme" Margin="0,0,0,8" Checked="Theme_Checked" />
                    <RadioButton x:Name="ThemeGlassRadio" GroupName="Theme" Content="Liquid Glass — translucent blue modern theme" Margin="0,0,0,8" Checked="Theme_Checked" />
                    <RadioButton x:Name="ThemeOledRadio" GroupName="Theme" Content="OLED — pure black, flat, purple accents" Checked="Theme_Checked" />
                    <TextBlock Text="Accent colour is chosen per theme from the Accent button in the header." Foreground="{DynamicResource Muted}" Margin="0,16,0,0" />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="3" Background="{DynamicResource TitleBackground}" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0">
            <DockPanel Margin="14,0" LastChildFill="False">
                <TextBlock x:Name="FooterRight" DockPanel.Dock="Right" Foreground="{DynamicResource Muted}" FontFamily="Consolas" FontSize="11" VerticalAlignment="Center" />
                <TextBlock x:Name="FooterLeft" Foreground="{DynamicResource Muted}" FontFamily="Consolas" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
